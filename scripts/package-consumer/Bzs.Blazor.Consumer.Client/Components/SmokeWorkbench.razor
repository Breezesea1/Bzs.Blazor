@inject IBzsDialogService DialogService

<BzsThemeProvider Mode="@_mode"
                  ModeChanged="SetMode"
                  data-testid="@($"{Runtime}-theme")">
    <h1>@Runtime package smoke</h1>
    <p role="status" data-testid="@($"{Runtime}-ready")">
        @(_ready ? "Interactive package ready" : "Package prerender")
    </p>
    <p data-testid="@($"{Runtime}-culture")">@CultureInfo.CurrentUICulture.Name</p>

    <BzsButton Variant="BzsButtonVariant.Outline" Click="UseDarkTheme">Use dark theme</BzsButton>

    <EditForm Model="_model" FormName="@($"{Runtime}-form")">
        <BzsTextInput @bind-Value="_model.Search"
                      Label="Package search"
                      InputType="BzsTextInputType.Search"
                      UpdateMode="BzsInputUpdateMode.Input"
                      data-testid="@($"{Runtime}-search")" />
        <BzsPasswordInput @bind-Value="_model.Password"
                          Label="Package password"
                          Revealable="true"
                          ShowPasswordText="Show package password"
                          HidePasswordText="Hide package password"
                          data-testid="@($"{Runtime}-password")" />
        <BzsNumberInput TValue="int"
                        @bind-Value="_model.ReviewerCount"
                        Label="Reviewer count"
                        data-testid="@($"{Runtime}-number")" />
        <BzsDateInput TValue="DateOnly"
                      @bind-Value="_model.ReleaseDate"
                      Label="Release date"
                      data-testid="@($"{Runtime}-date")" />
        <BzsSelect TValue="string"
                   @bind-Value="_model.Stage"
                   Options="StageOptions"
                   Label="Stage"
                   data-testid="@($"{Runtime}-select")" />
    </EditForm>
    <p data-testid="@($"{Runtime}-search-value")">@_model.Search</p>
    <p data-testid="@($"{Runtime}-date-value")">
        @_model.ReleaseDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
    </p>

    <BzsPopover Open="@_popoverOpen"
                OpenChanged="value => _popoverOpen = value"
                TriggerAccessibleName="Open package details"
                ContentRole="dialog"
                ContentAccessibleName="Package details"
                data-testid="@($"{Runtime}-popover")">
        <TriggerContent>Package details</TriggerContent>
        <ChildContent>Anchored package content.</ChildContent>
    </BzsPopover>

    <EditForm Model="_model" FormName="@($"{Runtime}-productivity-form")">
        <BzsAutocomplete TValue="string"
                         @bind-Value="_model.Owner"
                         Provider="_ownerProvider"
                         Label="Package owner"
                         MinimumQueryLength="1"
                         DebounceDelay="@TimeSpan.Zero"
                         data-testid="@($"{Runtime}-autocomplete")" />
        <BzsFileUpload @bind-Value="_model.Files"
                       Label="Package attachments"
                       Multiple="true"
                       MaximumFileCount="2"
                       Accept=".txt"
                       data-testid="@($"{Runtime}-upload")" />
    </EditForm>
    <p data-testid="@($"{Runtime}-owner-value")">@_model.Owner</p>

    <BzsDataGrid @ref="_grid"
                 TItem="SmokeRow"
                 Provider="_gridProvider"
                 Page="_gridPage"
                 PageChanged="value => _gridPage = value"
                 PageSize="3"
                 PageSizeOptions="GridPageSizes"
                 Sort="_gridSort"
                 SortChanged="value => _gridSort = value"
                 ItemKey="row => row.Id"
                 SelectionMode="BzsDataGridSelectionMode.Multiple"
                 ShowSelectAll="true"
                 SelectAllText="Select current package page"
                 SelectedItems="_selectedRows"
                 SelectedItemsChanged="SetSelectedRows"
                 ShowPageSizeSelector="false"
                 ShowPagination="false"
                 PaginationAccessibleName="Package pagination"
                 Caption="Package work items"
                 AccessibleName="Package work items"
                 data-testid="@($"{Runtime}-grid")">
        <BzsDataGridColumn TItem="SmokeRow"
                           Key="title"
                           Title="Work item"
                           ValueSelector="row => row.Title"
                           Sortable="true" />
        <BzsDataGridColumn TItem="SmokeRow"
                           Key="owner"
                           Title="Owner"
                           ValueSelector="row => row.Owner" />
    </BzsDataGrid>
    <BzsButton Click="RefreshGridAsync" data-testid="@($"{Runtime}-refresh-grid")">
        Refresh package grid
    </BzsButton>
    <p data-testid="@($"{Runtime}-selected-count")">@_selectedRows.Count</p>

    <BzsTabs AccessibleName="Package tabs" data-testid="@($"{Runtime}-tabs")">
        <BzsTabItem Value="summary" Title="Summary">Summary package content.</BzsTabItem>
        <BzsTabItem Value="details" Title="Details">Details package content.</BzsTabItem>
    </BzsTabs>

    <BzsButton Click="OpenDialogAsync" data-testid="@($"{Runtime}-open-dialog")">
        Open package dialog
    </BzsButton>
    <p data-testid="@($"{Runtime}-dialog-result")">@_dialogResult</p>
    <BzsOverlayHost data-testid="@($"{Runtime}-overlay-host")" />

    <BzsButton Click="OpenDrawer" data-testid="@($"{Runtime}-open-drawer")">
        Open package navigation
    </BzsButton>
    <BzsNavigationDrawer Id="@($"{Runtime}-drawer")"
                         Style="position: fixed; inset: 0;"
                         Open="_drawerOpen"
                         OpenChanged="SetDrawerOpen"
                         Variant="BzsNavigationDrawerVariant.Temporary"
                         InitialFocusSelector="@($"#{Runtime}-drawer-focus")"
                         AccessibleName="Package navigation"
                         data-testid="@($"{Runtime}-drawer")">
        <button id="@($"{Runtime}-drawer-focus")"
                type="button"
                data-testid="@($"{Runtime}-drawer-focus")">
            Package navigation target
        </button>
    </BzsNavigationDrawer>
</BzsThemeProvider>

@code {
    private static readonly IReadOnlyList<BzsSelectOption<string>> StageOptions =
    [
        new("layout", "Layout"),
        new("review", "Review"),
    ];

    private readonly SmokeModel _model = new();
    private readonly OwnerProvider _ownerProvider = new();
    private readonly GridProvider _gridProvider = new();
    private BzsDataGrid<SmokeRow>? _grid;
    private BzsThemeMode _mode = BzsThemeMode.System;
    private BzsDataGridSort? _gridSort;
    private int _gridPage = 1;
    private bool _popoverOpen;
    private bool _drawerOpen;
    private bool _ready;
    private IReadOnlyList<SmokeRow> _selectedRows = Array.Empty<SmokeRow>();
    private string _dialogResult = "No dialog result.";
    private static readonly IReadOnlyList<int> GridPageSizes = [3];

    [Parameter, EditorRequired]
    public string Runtime { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SetMode(BzsThemeMode mode)
    {
        _mode = mode;
        return Task.CompletedTask;
    }

    private Task UseDarkTheme() => SetMode(BzsThemeMode.Dark);

    private void OpenDrawer() => _drawerOpen = true;

    private Task SetDrawerOpen(bool open)
    {
        _drawerOpen = open;
        return Task.CompletedTask;
    }

    private Task SetSelectedRows(IReadOnlyList<SmokeRow> rows)
    {
        _selectedRows = rows;
        return Task.CompletedTask;
    }

    private async Task RefreshGridAsync()
    {
        _gridProvider.Advance();
        if (_grid is not null)
        {
            await _grid.RefreshAsync();
        }
    }

    private async Task OpenDialogAsync()
    {
        var result = await DialogService.ShowAsync<PackageDialog, bool>(
            parameters => parameters.Add(
                component => component.Prompt,
                $"Complete the {Runtime} package workflow?"),
            new BzsDialogOptions
            {
                Title = "Package dialog",
                AccessibleName = "Package dialog",
                InitialFocusSelector = "#package-dialog-complete",
            });

        _dialogResult = result.IsCompleted && result.Value == true
            ? "Completed: true"
            : $"Result: {result.Kind}";
    }

    private sealed class SmokeModel
    {
        public string? Search { get; set; }

        public string? Password { get; set; }

        public int ReviewerCount { get; set; } = 2;

        public DateOnly ReleaseDate { get; set; } = new(2026, 7, 17);

        public string Stage { get; set; } = "layout";

        public string Owner { get; set; } = string.Empty;

        public IReadOnlyList<IBrowserFile> Files { get; set; } = Array.Empty<IBrowserFile>();
    }

    private sealed class OwnerProvider : IBzsAutocompleteProvider<string>
    {
        private static readonly IReadOnlyList<BzsAutocompleteOption<string>> Options =
        [
            new("alicia", "Alicia Santos"),
            new("ben", "Ben Carter"),
        ];

        public async ValueTask<IReadOnlyList<BzsAutocompleteOption<string>>> GetSuggestionsAsync(
            string query,
            CancellationToken cancellationToken)
        {
            await Task.Delay(TimeSpan.FromMilliseconds(25), cancellationToken);
            return Options
                .Where(option => option.Label.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }
    }

    private sealed class GridProvider : IBzsDataGridProvider<SmokeRow>
    {
        private static readonly IReadOnlyList<SmokeRow> Rows =
        [
            new(1, "Accessibility review", "Alicia Santos"),
            new(2, "Package verification", "Ben Carter"),
            new(3, "AOT smoke", "Mei Lin"),
            new(4, "Release notes", "Alicia Santos"),
        ];
        private int _revision = 1;

        public void Advance() => _revision++;

        public async ValueTask<BzsDataGridResult<SmokeRow>> GetItemsAsync(
            BzsDataGridRequest request,
            CancellationToken cancellationToken)
        {
            await Task.Delay(TimeSpan.FromMilliseconds(25), cancellationToken);
            var rows = Rows.Select(row => row.Id == 2
                ? row with { Title = $"Package verification v{_revision}" }
                : row);
            var query = request.Sort?.Direction == BzsDataGridSortDirection.Descending
                ? rows.OrderByDescending(row => row.Title, StringComparer.Ordinal)
                : rows.OrderBy(row => row.Title, StringComparer.Ordinal);
            var items = query
                .Skip((request.Page - 1) * request.PageSize)
                .Take(request.PageSize)
                .ToArray();
            return new BzsDataGridResult<SmokeRow>(items, Rows.Count);
        }
    }

    private sealed record SmokeRow(int Id, string Title, string Owner);
}
