@namespace Bzs.Blazor
@typeparam TValue
@inherits BzsInputBase<IReadOnlyList<TValue>>
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<BzsField InputId="@InputId" Label="@Label" Description="@Description" Error="@FieldError" Required="@Required">
    @if (!_isInteractive)
    {
        <select @attributes="NativeInputAttributes" multiple size="@NativeSize">
            @foreach (var option in Options)
            {
                <option @key="option.ValueText"
                        value="@option.ValueText"
                        disabled="@option.Disabled"
                        selected="@IsSelected(option.Value)">@option.Label</option>
            }
        </select>
        @if (ReadOnly && !Disabled)
        {
            @foreach (var option in SelectedOptions)
            {
                <input @key="option.ValueText" type="hidden" name="@InputName" value="@option.ValueText" />
            }
        }
    }
    else
    {
    <div class="bzs-multi-select" @ref="_rootReference">
        <button @attributes="TriggerAttributes"
                @ref="_triggerReference"
                @onclick="ToggleAsync"
                @onkeydown="HandleKeyDownAsync">
            <span class="bzs-multi-select__value @(SelectedOptions.Count == 0 ? "bzs-multi-select__value--placeholder" : null)">
                @SelectedText
            </span>
            <BzsIcon Icon="BzsIcons.ChevronDown" Class="bzs-multi-select__chevron" />
        </button>

        @if (Required && !Disabled && !ReadOnly)
        {
            <select @attributes="ConstraintInputAttributes">
                @foreach (var option in Options)
                {
                    <option @key="option.ValueText"
                            value="@option.ValueText"
                            disabled="@option.Disabled"
                            selected="@IsSelected(option.Value)">@option.Label</option>
                }
            </select>
        }

        @if (_isOpen)
        {
            <div class="bzs-multi-select__panel" data-bzs-select-panel="true">
                @if (SearchEnabled)
                {
                    <label class="bzs-multi-select__search">
                        <BzsIcon Icon="BzsIcons.Search" Class="bzs-multi-select__search-icon" />
                        <input id="@SearchId"
                               @ref="_searchReference"
                               type="search"
                               value="@_searchText"
                               placeholder="@EffectiveSearchPlaceholder"
                               aria-label="@EffectiveSearchPlaceholder"
                               aria-controls="@ListboxId"
                               aria-activedescendant="@ActiveOptionId"
                               autocomplete="off"
                               spellcheck="false"
                               @oninput="OnSearchInput"
                               @onkeydown="HandleKeyDownAsync" />
                    </label>
                    <div class="bzs-multi-select__actions">
                        <button type="button" disabled="@(!HasEnabledFilteredOptions)" @onclick="SelectVisibleAsync">@EffectiveSelectAllText</button>
                        <button type="button" disabled="@(!HasEnabledFilteredOptions)" @onclick="InvertVisibleAsync">@EffectiveInvertSelectionText</button>
                        <button type="button" disabled="@(!HasClearableFilteredSelection)" @onclick="ClearAsync">@EffectiveClearSelectionText</button>
                    </div>
                }

                <div id="@ListboxId"
                     class="bzs-multi-select__options"
                     role="listbox"
                     aria-label="@EffectiveAccessibleName"
                     aria-multiselectable="true">
                    @if (FilteredOptions.Count == 0)
                    {
                        <div class="bzs-multi-select__empty" role="status">@EffectiveEmptyText</div>
                    }
                    else
                    {
                        @for (var index = 0; index < FilteredOptions.Count; index++)
                        {
                            var option = FilteredOptions[index];
                            var selected = IsSelected(option.Value);
                            <button id="@GetOptionId(option)"
                                    @key="option.ValueText"
                                    type="button"
                                    role="option"
                                    tabindex="-1"
                                    class="@GetOptionClass(index, selected, option.Disabled)"
                                    aria-selected="@(selected ? "true" : "false")"
                                    disabled="@option.Disabled"
                                    @onmouseenter="() => Activate(index)"
                                    @onclick="() => ToggleOptionAsync(option)">
                                <span class="bzs-multi-select__check" aria-hidden="true">
                                    @if (selected)
                                    {
                                        <BzsIcon Icon="BzsIcons.Check" />
                                    }
                                </span>
                                <span class="bzs-multi-select__option-content">
                                    <span class="bzs-multi-select__option-heading">
                                        @if (option.Icon is not null)
                                        {
                                            <BzsIcon Icon="option.Icon" Class="bzs-multi-select__option-icon" />
                                        }
                                        <span class="bzs-multi-select__option-label">@option.Label</span>
                                    </span>
                                    @if (option.Description is not null)
                                    {
                                        <span class="bzs-multi-select__option-description">@option.Description</span>
                                    }
                                </span>
                            </button>
                        }
                    }
                </div>
            </div>
        }

        @if (!Disabled)
        {
            @foreach (var option in SelectedOptions)
            {
                <input @key="option.ValueText" type="hidden" name="@InputName" value="@option.ValueText" />
            }
        }
    </div>
    }
</BzsField>
