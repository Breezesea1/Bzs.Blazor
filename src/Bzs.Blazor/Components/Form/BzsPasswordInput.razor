@namespace Bzs.Blazor
@inherits BzsInputBase<string?>

<BzsField InputId="@InputId" Label="@Label" Description="@Description" Error="@FieldError" Required="@Required">
    <div class="bzs-password-input">
        <input @ref="_inputReference" @attributes="InputAttributes" value="@CurrentValueAsString" @onchange="OnChanged" />
        @if (Revealable)
        {
            <button type="button"
                    class="bzs-password-input__reveal"
                    aria-label="@RevealAccessibleLabel"
                    aria-pressed="@_revealed"
                    disabled="@Disabled"
                    @onmousedown:preventDefault
                    @onclick="ToggleRevealAsync">
                <BzsIcon Icon="@(_revealed ? BzsIcons.EyeOff : BzsIcons.Eye)" />
            </button>
        }
    </div>
</BzsField>
