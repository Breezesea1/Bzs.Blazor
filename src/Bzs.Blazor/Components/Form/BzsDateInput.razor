@namespace Bzs.Blazor
@typeparam TValue
@inherits BzsInputBase<TValue>
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject Microsoft.Extensions.Logging.ILoggerFactory LoggerFactory

<BzsField InputId="@InputId" Label="@Label" Description="@Description" Error="@FieldError" Required="@Required">
    @if (!_isInteractive)
    {
        <input @attributes="NativeInputAttributes" value="@NativeValueAsString" @onchange="OnNativeChanged" />
    }
    else
    {
        <div class="bzs-date-picker" lang="@ExplicitCultureName" dir="@ExplicitCultureDirection" @ref="_rootReference">
            <div class="bzs-date-picker__input-shell">
                <input @attributes="TextInputAttributes"
                       @ref="_inputReference"
                       data-bzs-date-picker-input="true"
                       data-bzs-inline-overlay-owner="@_instanceId"
                       value="@CurrentValueAsString"
                       @onchange="OnTextChanged"
                       @onclick="OpenAtPointer"
                       @onkeydown="HandleInputKeyDownAsync" />
                <button type="button"
                        class="bzs-date-picker__open"
                        aria-label="@LocalizeDatePicker("DatePickerOpenCalendar")"
                        title="@LocalizeDatePicker("DatePickerOpenCalendar")"
                        data-bzs-inline-overlay-for="@_instanceId"
                        disabled="@(Disabled || ReadOnly)"
                        tabindex="-1"
                        @onclick="OpenAtPointer"
                        @onkeydown="HandleInputKeyDownAsync">
                    <BzsIcon Icon="BzsIcons.Calendar" />
                </button>
            </div>

            @if (_isOpen)
            {
                <div id="@PanelId"
                     class="bzs-date-picker__panel"
                     popover="manual"
                     role="dialog"
                     aria-modal="false"
                     aria-label="@LocalizeDatePicker("DatePickerCalendarLabel")"
                     data-bzs-date-picker-panel="true"
                     @onkeydown="HandleDialogKeyDownAsync">
                    <header class="bzs-date-picker__header">
                        <button type="button"
                                class="bzs-date-picker__nav"
                                aria-label="@LocalizeDatePicker("DatePickerPreviousMonth")"
                                title="@LocalizeDatePicker("DatePickerPreviousMonth")"
                                disabled="@(!CanNavigatePreviousMonth)"
                                @onclick="() => ShiftViewMonth(-1)">
                            <BzsIcon Icon="BzsIcons.ChevronLeft" />
                        </button>

                        <div class="bzs-date-picker__period">
                            <div class="bzs-date-picker__period-field">
                                <button type="button"
                                        class="bzs-date-picker__period-trigger"
                                        role="combobox"
                                        aria-label="@LocalizeDatePicker("DatePickerMonth")"
                                        aria-haspopup="listbox"
                                        aria-expanded="@IsMonthMenuOpen"
                                        aria-controls="@MonthListboxId"
                                        aria-activedescendant="@ActiveMonthOptionId"
                                        data-bzs-date-picker-period="month"
                                        @onclick="args => ActivatePeriodMenu(DatePeriodMenu.Month, args)"
                                        @onkeydown="args => HandlePeriodKeyDownAsync(DatePeriodMenu.Month, args)"
                                        @onkeydown:stopPropagation="true">
                                    <span>@GetMonthName(_viewMonth.Month)</span>
                                    <BzsIcon Icon="BzsIcons.ChevronDown" />
                                </button>
                                @if (_openPeriodMenu == DatePeriodMenu.Month)
                                {
                                    <div id="@MonthListboxId"
                                         class="bzs-date-picker__period-menu"
                                         role="listbox"
                                         aria-label="@LocalizeDatePicker("DatePickerMonth")"
                                         @ref="_periodMenuReference">
                                        @foreach (var month in AvailableMonths)
                                        {
                                            var selected = month == _viewMonth.Month;
                                            <button id="@GetMonthOptionId(month)"
                                                    @key="month"
                                                    type="button"
                                                    role="option"
                                                    tabindex="-1"
                                                    class="@GetPeriodOptionClass(selected, month == _activeMonth)"
                                                    aria-selected="@(selected ? "true" : "false")"
                                                    @onmousedown:preventDefault="true"
                                                    @onmouseenter="() => ActivateMonth(month)"
                                                    @onclick="() => SelectMonth(month)">
                                                <span>@GetMonthName(month)</span>
                                                @if (selected)
                                                {
                                                    <BzsIcon Icon="BzsIcons.Check" />
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="bzs-date-picker__period-field">
                                <button type="button"
                                        class="bzs-date-picker__period-trigger"
                                        role="combobox"
                                        aria-label="@LocalizeDatePicker("DatePickerYear")"
                                        aria-haspopup="listbox"
                                        aria-expanded="@IsYearMenuOpen"
                                        aria-controls="@YearListboxId"
                                        aria-activedescendant="@ActiveYearOptionId"
                                        data-bzs-date-picker-period="year"
                                        @onclick="args => ActivatePeriodMenu(DatePeriodMenu.Year, args)"
                                        @onkeydown="args => HandlePeriodKeyDownAsync(DatePeriodMenu.Year, args)"
                                        @onkeydown:stopPropagation="true">
                                    <span>@_viewMonth.Year</span>
                                    <BzsIcon Icon="BzsIcons.ChevronDown" />
                                </button>
                                @if (_openPeriodMenu == DatePeriodMenu.Year)
                                {
                                    <div id="@YearListboxId"
                                         class="bzs-date-picker__period-menu bzs-date-picker__period-menu--year"
                                         role="listbox"
                                         aria-label="@LocalizeDatePicker("DatePickerYear")"
                                         @ref="_periodMenuReference">
                                        @foreach (var year in AvailableYears)
                                        {
                                            var selected = year == _viewMonth.Year;
                                            <button id="@GetYearOptionId(year)"
                                                    @key="year"
                                                    type="button"
                                                    role="option"
                                                    tabindex="-1"
                                                    class="@GetPeriodOptionClass(selected, year == _activeYear)"
                                                    aria-selected="@(selected ? "true" : "false")"
                                                    @onmousedown:preventDefault="true"
                                                    @onmouseenter="() => ActivateYear(year)"
                                                    @onclick="() => SelectYear(year)">
                                                <span>@year</span>
                                                @if (selected)
                                                {
                                                    <BzsIcon Icon="BzsIcons.Check" />
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <button type="button"
                                class="bzs-date-picker__nav"
                                aria-label="@LocalizeDatePicker("DatePickerNextMonth")"
                                title="@LocalizeDatePicker("DatePickerNextMonth")"
                                disabled="@(!CanNavigateNextMonth)"
                                @onclick="() => ShiftViewMonth(1)">
                            <BzsIcon Icon="BzsIcons.ChevronRight" />
                        </button>
                    </header>

                    @{
                        var calendarDays = CalendarDays;
                    }
                    <div class="bzs-date-picker__calendar"
                         role="grid"
                         aria-label="@ViewMonthAccessibleLabel"
                         aria-rowcount="7"
                         aria-colcount="7"
                         @onkeydown="HandleCalendarKeyDownAsync">
                        <div class="bzs-date-picker__weekdays" role="row">
                            @foreach (var weekday in Weekdays)
                            {
                                <span role="columnheader" title="@weekday.FullName">@weekday.ShortName</span>
                            }
                        </div>
                        @for (var week = 0; week < 6; week++)
                        {
                            <div class="bzs-date-picker__week" role="row">
                            @for (var dayIndex = 0; dayIndex < 7; dayIndex++)
                            {
                                var day = calendarDays[week * 7 + dayIndex];
                                if (day.Date is { } date)
                                {
                                    <button @key="date.DayNumber"
                                            type="button"
                                            role="gridcell"
                                            class="@GetDayClass(day)"
                                            aria-label="@FormatAccessibleDate(date)"
                                            aria-selected="@(day.IsSelected ? "true" : "false")"
                                            aria-current="@(day.IsToday ? "date" : null)"
                                            tabindex="@(day.IsFocused ? "0" : "-1")"
                                            disabled="@day.IsDisabled"
                                            data-bzs-date-picker-day="true"
                                            data-date="@FormatNativeDate(date)"
                                            @onfocus="() => FocusDate(date)"
                                            @onclick="() => SelectDateAsync(date)">@date.Day</button>
                                }
                                else
                                {
                                    <span role="gridcell"
                                          class="bzs-date-picker__day bzs-date-picker__day--empty"
                                          aria-hidden="true"></span>
                                }
                            }
                            </div>
                        }
                    </div>

                    @if (ShowToday || Clearable)
                    {
                        <footer class="bzs-date-picker__actions">
                            @if (Clearable)
                            {
                                <button type="button"
                                        class="bzs-date-picker__action"
                                        disabled="@string.IsNullOrWhiteSpace(CurrentValueAsString)"
                                        @onclick="ClearAsync">@LocalizeDatePicker("DatePickerClear")</button>
                            }
                            @if (ShowToday)
                            {
                                <button type="button"
                                        class="bzs-date-picker__action bzs-date-picker__action--primary"
                                        disabled="@(!IsDateAllowed(Today))"
                                        @onclick="SelectTodayAsync">@LocalizeDatePicker("DatePickerToday")</button>
                            }
                        </footer>
                    }
                </div>
            }
        </div>
    }
</BzsField>
