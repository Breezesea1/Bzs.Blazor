@namespace Bzs.Blazor
@typeparam TValue
@inherits BzsInputBase<TValue>
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject Microsoft.Extensions.Logging.ILoggerFactory LoggerFactory

<BzsField InputId="@InputId" Label="@Label" Description="@Description" Error="@FieldError" Required="@Required">
    @if (!_isInteractive)
    {
        <select @attributes="NativeInputAttributes" @onchange="OnNativeChanged">
            @if (SelectedOption is null || !string.IsNullOrWhiteSpace(PlaceholderOption))
            {
                <option value="" selected="@(SelectedOption is null)">
                    @(string.IsNullOrWhiteSpace(PlaceholderOption) ? Localize("SelectPlaceholder") : PlaceholderOption.Trim())
                </option>
            }
            @foreach (var option in Options)
            {
                <option @key="option.ValueText"
                        value="@option.ValueText"
                        disabled="@option.Disabled"
                        selected="@IsSelected(option.Value)">@option.Label</option>
            }
        </select>
        @if (ReadOnly && !Disabled && CurrentValueAsString is not null)
        {
            <input type="hidden" name="@InputName" value="@CurrentValueAsString" />
        }
    }
    else
    {
    <div class="bzs-select" @ref="_rootReference">
        <button @attributes="TriggerAttributes"
                @ref="_triggerReference"
                @onclick="ToggleAsync"
                @onkeydown="HandleKeyDownAsync">
            <span class="bzs-select__value @(SelectedOption is null ? "bzs-select__value--placeholder" : null)">
                @SelectedText
            </span>
            <BzsIcon Icon="BzsIcons.ChevronDown" Class="bzs-select__chevron" />
        </button>

        @if (Required && !Disabled && !ReadOnly)
        {
            <select @attributes="ConstraintInputAttributes">
                <option value="" selected="@(SelectedOption is null)"></option>
                @foreach (var option in Options)
                {
                    <option @key="option.ValueText"
                            value="@option.ValueText"
                            disabled="@option.Disabled"
                            selected="@IsSelected(option.Value)">@option.Label</option>
                }
            </select>
        }

        @if (_isOpen)
        {
            <div class="bzs-select__panel" data-bzs-select-panel="true">
                @if (SearchEnabled)
                {
                    <label class="bzs-select__search">
                        <BzsIcon Icon="BzsIcons.Search" Class="bzs-select__search-icon" />
                        <input id="@SearchId"
                               @ref="_searchReference"
                               type="search"
                               value="@_searchText"
                               placeholder="@EffectiveSearchPlaceholder"
                               aria-label="@EffectiveSearchPlaceholder"
                               aria-controls="@ListboxId"
                               aria-activedescendant="@ActiveOptionId"
                               autocomplete="off"
                               spellcheck="false"
                               @oninput="OnSearchInput"
                               @onkeydown="HandleKeyDownAsync" />
                    </label>
                }

                <div id="@ListboxId"
                     class="bzs-select__options"
                     role="listbox"
                     aria-label="@EffectiveAccessibleName">
                    @if (FilteredOptions.Count == 0)
                    {
                        <div class="bzs-select__empty" role="status">@EffectiveEmptyText</div>
                    }
                    else
                    {
                        @for (var index = 0; index < FilteredOptions.Count; index++)
                        {
                            var option = FilteredOptions[index];
                            var selected = IsSelected(option.Value);
                            <button id="@GetOptionId(option)"
                                    @key="option.ValueText"
                                    type="button"
                                    role="option"
                                    tabindex="-1"
                                    class="@GetOptionClass(index, selected, option.Disabled)"
                                    aria-selected="@(selected ? "true" : "false")"
                                    disabled="@option.Disabled"
                                    @onmouseenter="() => Activate(index)"
                                    @onclick="() => SelectAsync(option)">
                                <span class="bzs-select__option-content">
                                    <span class="bzs-select__option-heading">
                                        @if (option.Icon is not null)
                                        {
                                            <BzsIcon Icon="option.Icon" Class="bzs-select__option-icon" />
                                        }
                                        <span class="bzs-select__option-label">@option.Label</span>
                                    </span>
                                    @if (option.Description is not null)
                                    {
                                        <span class="bzs-select__option-description">@option.Description</span>
                                    }
                                </span>
                                @if (selected)
                                {
                                    <BzsIcon Icon="BzsIcons.Check" Class="bzs-select__check" />
                                }
                            </button>
                        }
                    }
                </div>
            </div>
        }

        @if (!Disabled && CurrentValueAsString is not null)
        {
            <input type="hidden" name="@InputName" value="@CurrentValueAsString" />
        }
    </div>
    }
</BzsField>
