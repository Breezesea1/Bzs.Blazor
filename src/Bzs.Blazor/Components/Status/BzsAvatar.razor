@namespace Bzs.Blazor
@inherits BzsComponentBase

<span @attributes="RootAttributes">
    <span class="bzs-avatar__visual" aria-hidden="true">
        <span class="bzs-avatar__fallback">
            @FallbackContent
        </span>
        @if (HasImage)
        {
            <img class="bzs-avatar__image"
                 src="@ImageUrl!.Trim()"
                 alt=""
                 aria-hidden="true"
                 draggable="false" />
        }
    </span>
    @if (HasName)
    {
        <span class="bzs-avatar__name"
              aria-hidden="@(HasExplicitAccessibleName ? "true" : null)">@NormalizedName</span>
    }
    @if (HasAction)
    {
        <span class="bzs-avatar__action">
            @ActionContent
        </span>
    }
</span>
