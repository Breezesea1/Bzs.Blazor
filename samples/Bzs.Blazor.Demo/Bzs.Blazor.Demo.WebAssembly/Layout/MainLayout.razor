@inherits LayoutComponentBase

<div class="demo-shell">
    <aside class="demo-sidebar">
        <NavMenu />
    </aside>

    <main id="main-content" class="demo-main">
        <header class="demo-header">
            <p class="demo-header-context">
                <span>Bzs.Blazor</span>
                <span class="demo-header-separator" aria-hidden="true">/</span>
                <strong>Component workbench</strong>
            </p>
            <p class="demo-header-status">
                <span class="demo-status-dot" aria-hidden="true"></span>
                Static WebAssembly host
            </p>
            <DemoLanguageSwitcher UseStaticHostRootReload="true" />
        </header>
        <article class="demo-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    The catalog could not complete this interaction.
    <a href=".">Reload</a>
</div>
