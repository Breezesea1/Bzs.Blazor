@page "/not-found"
@inject NavigationManager Navigation

<PageTitle>Not found - Bzs.Blazor</PageTitle>

<section class="demo-page" aria-labelledby="not-found-title">
    <header class="demo-page-header">
        <p class="demo-eyebrow">404</p>
        <h1 id="not-found-title">Page not found</h1>
        <p class="demo-page-summary">The requested catalog route is not available in this static demo.</p>
    </header>
    <p><a href="@RouteUrl("")">Return to the catalog overview</a></p>
</section>

@code {
    private string RouteUrl(string route) => DemoCulture.PreserveCulture(
        new Uri(Navigation.Uri),
        new Uri(Navigation.BaseUri),
        route);
}
