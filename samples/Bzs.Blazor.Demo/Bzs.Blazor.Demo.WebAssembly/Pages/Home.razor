@page "/"
@inject NavigationManager Navigation

<PageTitle>Bzs.Blazor catalog</PageTitle>

<section class="demo-page" aria-labelledby="catalog-title">
    <header class="demo-page-header">
        <p class="demo-eyebrow">.NET 10 component catalog</p>
        <h1 id="catalog-title">Bzs.Blazor</h1>
        <p class="demo-page-summary">
            Foundation, forms, feedback, navigation, and overlays in one focused workbench.
        </p>
    </header>

    <section class="demo-overview-section" aria-labelledby="component-catalog-title">
        <div class="demo-section-heading">
            <h2 id="component-catalog-title">Component groups</h2>
        </div>
        <div class="demo-overview-grid">
            <a class="demo-overview-card" href="@RouteUrl("theme-foundation")"><span class="demo-overview-card-index">01</span><strong>Theme foundation</strong></a>
            <a class="demo-overview-card" href="@RouteUrl("foundation")"><span class="demo-overview-card-index">02</span><strong>Foundation</strong></a>
            <a class="demo-overview-card" href="@RouteUrl("forms")"><span class="demo-overview-card-index">03</span><strong>Forms</strong></a>
            <a class="demo-overview-card" href="@RouteUrl("feedback")"><span class="demo-overview-card-index">04</span><strong>Feedback</strong></a>
            <a class="demo-overview-card" href="@RouteUrl("tabs")"><span class="demo-overview-card-index">05</span><strong>Tabs</strong></a>
            <a class="demo-overview-card" href="@RouteUrl("overlays")"><span class="demo-overview-card-index">06</span><strong>Overlays</strong></a>
        </div>
    </section>

    <section class="demo-overview-section" aria-labelledby="route-catalog-title">
        <h2 id="route-catalog-title">GitHub Pages runtime</h2>
        <ul class="demo-route-list">
            <li>
                <a href="@RouteUrl("render-modes/webassembly")">Interactive WebAssembly</a>
                <span>Browser-hosted interaction without a server runtime.</span>
            </li>
        </ul>
    </section>
</section>

@code {
    private string RouteUrl(string route) => DemoCulture.PreserveCulture(
        new Uri(Navigation.Uri),
        new Uri(Navigation.BaseUri),
        route);
}
