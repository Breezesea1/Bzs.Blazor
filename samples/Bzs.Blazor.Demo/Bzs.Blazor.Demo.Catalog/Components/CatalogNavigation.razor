<div class="demo-nav">
    <div class="demo-brand">
        <a class="demo-brand-link" href="@DestinationUrl(DemoCatalogDestinations.Overview)">
            <img class="demo-brand-mark" src="_content/Bzs.Blazor.Demo.Catalog/demo-logo.svg" alt="" width="36" height="36" />
            <span class="demo-brand-copy">
                <strong>Bzs.Blazor</strong>
                <small>@DemoText.Chrome.BrandTagline</small>
            </span>
        </a>
        <BzsButton Class="demo-navigation-toggle demo-navigation-toggle--close"
                   Variant="BzsButtonVariant.Secondary"
                   Size="BzsButtonSize.Small"
                   StartIcon="@BzsIcons.ChevronLeft"
                   AccessibleName="@DemoText.Chrome.CloseNavigation"
                   data-demo-navigation-toggle="true"
                   data-demo-navigation-toggle-mode="close"
                   aria-controls="demo-navigation-drawer"
                   aria-expanded="true" />
    </div>

    @foreach (var section in NavigationSections)
    {
        <div class="demo-nav-section" @key="section.Name">
            <p class="demo-nav-heading">@section.Name</p>
            @foreach (var destination in section.Destinations)
            {
                <NavLink class="demo-nav-link"
                         href="@DestinationUrl(destination)"
                         Match="@(ReferenceEquals(destination, DemoCatalogDestinations.Overview) ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         @key="destination.Id">
                    <BzsIcon Icon="destination.Icon" />
                    <span class="demo-nav-link-label">@destination.Name</span>
                </NavLink>
            }
        </div>
    }

    <div class="demo-user">
        <BzsAvatar Initials="@DemoText.Chrome.DemoUserAvatarInitial"
                   Name="@DemoText.Chrome.DemoUser"
                   Size="BzsAvatarSize.Medium"
                   Class="demo-user-identity">
            <ActionContent>
                <a class="demo-user-action" href="@DestinationUrl(DemoCatalogDestinations.Overview)" aria-label="@DemoText.Chrome.SignOutAccessibleName">
                    <BzsIcon Icon="DemoNavIcons.LogOut" />
                    <span class="demo-user-action-label">@DemoText.Chrome.Exit</span>
                </a>
            </ActionContent>
        </BzsAvatar>
    </div>
</div>
