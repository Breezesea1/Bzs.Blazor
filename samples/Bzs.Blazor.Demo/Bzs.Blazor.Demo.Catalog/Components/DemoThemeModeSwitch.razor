@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="demo-theme-switch" role="group" aria-label="@DemoText.Chrome.ThemeSwitcherAccessibleName">
    <BzsButton Variant="BzsButtonVariant.Ghost"
               Size="BzsButtonSize.Small"
               Class="demo-theme-switch-option"
               aria-pressed="true"
               data-demo-theme-mode="light">@DemoText.Chrome.ThemeLight</BzsButton>
    <BzsButton Variant="BzsButtonVariant.Ghost"
               Size="BzsButtonSize.Small"
               Class="demo-theme-switch-option"
               aria-pressed="false"
               data-demo-theme-mode="dark">@DemoText.Chrome.ThemeDark</BzsButton>
    <BzsButton Variant="BzsButtonVariant.Ghost"
               Size="BzsButtonSize.Small"
               Class="demo-theme-switch-option"
               aria-pressed="false"
               data-demo-theme-mode="system">@DemoText.Chrome.ThemeSystem</BzsButton>
</div>
