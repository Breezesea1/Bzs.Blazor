@if (_isInteractive)
{
    <div class="demo-header-language">
        <BzsRadioGroup TValue="string"
                       Value="@SelectedCulture"
                       ValueChanged="ChangeCulture"
                       ValueExpression="@(() => SelectedCulture)"
                       Options="LanguageOptions"
                       Variant="BzsRadioGroupVariant.Segmented"
                       aria-label="@DemoText.Chrome.LanguageSwitcherAccessibleName" />
    </div>
}
else
{
    <nav class="demo-header-language demo-language-fallback" aria-label="@DemoText.Chrome.LanguageSwitcherAccessibleName">
        <a href="@GetCultureUrl(EnglishCulture)"
           aria-current="@(SelectedCulture == EnglishCulture ? "page" : null)"
           data-enhance-nav="false">English</a>
        <a href="@GetCultureUrl(ChineseCulture)"
           aria-current="@(SelectedCulture == ChineseCulture ? "page" : null)"
           data-enhance-nav="false">中文</a>
    </nav>
}
