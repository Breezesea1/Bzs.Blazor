@inject IBzsDialogService DialogService

<section id="navigation-drawer-fixture"
         data-fixture-interactive="@(_interactive ? "true" : "false")"
         @onkeydown="RecordAncestorKeyDown">
    <output id="fixture-ancestor-key-count">@_ancestorKeyCount</output>
    <BzsButton Id="fixture-open" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="OpenDrawer">Open drawer</BzsButton>
    <BzsButton Id="fixture-open-with-initial-focus" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="OpenWithInitialFocus">Open drawer with initial focus</BzsButton>
    <BzsButton Id="fixture-close-external" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="CloseDrawer">Close drawer externally</BzsButton>
    <BzsButton Id="fixture-open-without-focusable" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="OpenWithoutFocusable">Open without focusable content</BzsButton>
    <BzsButton Id="fixture-variant-temporary" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="SetTemporary">Temporary</BzsButton>
    <BzsButton Id="fixture-variant-persistent" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="SetPersistent">Persistent</BzsButton>
    <BzsButton Id="fixture-variant-responsive" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="SetResponsive">Responsive</BzsButton>
    <BzsButton Id="fixture-toggle-backdrop-override" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="ToggleBackdropOverride">Toggle backdrop override</BzsButton>
    <BzsButton Id="fixture-toggle-backdrop-hidden" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="ToggleHiddenBackdrop">Toggle hidden backdrop</BzsButton>
    <BzsButton Id="fixture-toggle-close-on-backdrop-click" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="ToggleCloseOnBackdropClick">Toggle close on backdrop click</BzsButton>
    <BzsButton Id="fixture-reject-close" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="RejectClose">Reject close</BzsButton>
    <BzsButton Id="fixture-accept-close" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="AcceptClose">Accept close</BzsButton>

    <BzsOverlayHost id="fixture-overlay-host" />
    <output id="fixture-service-dialog-status">@_serviceDialogStatus</output>

    <BzsNavigationDrawer Id="fixture-drawer"
                         Class="@DrawerClass"
                         Style="position: fixed; inset: 0;"
                         Open="@_open"
                         OpenChanged="OnOpenChanged"
                         Variant="@_variant"
                         CloseOnBackdropClick="@_closeOnBackdropClick"
                         InitialFocusSelector="@_initialFocusSelector"
                         AccessibleName="Lifecycle navigation">
        @if (_showFocusableContent)
        {
            <BzsButton Id="fixture-close" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="CloseDrawer">Close drawer</BzsButton>
            <BzsButton Id="fixture-initial-focus-target" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small">Initial focus target</BzsButton>
            <BzsButton Id="fixture-open-service-dialog" Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Click="OpenServiceDialogAsync">Open service dialog</BzsButton>
            <a id="fixture-enhanced-navigation" href="/layout">Navigate</a>
        }
    </BzsNavigationDrawer>

    <main id="fixture-background" tabindex="0">Background</main>
</section>

@code {
    private bool _acceptClose = true;
    private int _ancestorKeyCount;
    private bool _closeOnBackdropClick = true;
    private bool _forceBackdrop;
    private bool _hideBackdrop;
    private string? _initialFocusSelector;
    private bool _interactive;
    private bool _open;
    private string _serviceDialogStatus = "Not opened";
    private bool _showFocusableContent = true;
    private BzsNavigationDrawerVariant _variant = BzsNavigationDrawerVariant.Temporary;

    private Task OnOpenChanged(bool open)
    {
        if (open || _acceptClose)
        {
            _open = open;
        }

        return Task.CompletedTask;
    }

    private void OpenDrawer()
    {
        _initialFocusSelector = null;
        _showFocusableContent = true;
        _open = true;
    }

    private void OpenWithInitialFocus()
    {
        _initialFocusSelector = "#fixture-initial-focus-target";
        _showFocusableContent = true;
        _open = true;
    }

    private async Task OpenWithoutFocusable()
    {
        await Task.Delay(100);
        _showFocusableContent = false;
        _open = true;
    }

    private void CloseDrawer() => _open = false;

    private void SetTemporary() => _variant = BzsNavigationDrawerVariant.Temporary;

    private void SetPersistent() => _variant = BzsNavigationDrawerVariant.Persistent;

    private void SetResponsive() => _variant = BzsNavigationDrawerVariant.Responsive;

    private void ToggleBackdropOverride() => _forceBackdrop = !_forceBackdrop;

    private void ToggleHiddenBackdrop() => _hideBackdrop = !_hideBackdrop;

    private void ToggleCloseOnBackdropClick() => _closeOnBackdropClick = !_closeOnBackdropClick;

    private void RejectClose() => _acceptClose = false;

    private void AcceptClose() => _acceptClose = true;

    private async Task OpenServiceDialogAsync()
    {
        var result = await DialogService.ShowAsync<OverlayResultDialog, bool>(
            parameters => parameters.Add(
                component => component.Prompt,
                "Complete the drawer workflow?"),
            new BzsDialogOptions
            {
                Title = "Drawer service dialog",
                AccessibleName = "Drawer service dialog",
                InitialFocusSelector = "#service-dialog-complete",
            });

        _serviceDialogStatus = result.IsCompleted
            ? "Completed"
            : $"Result: {result.Kind}";
    }

    private void RecordAncestorKeyDown() => _ancestorKeyCount++;

    private string? DrawerClass => string.Join(
        ' ',
        _forceBackdrop ? "fixture-force-backdrop" : null,
        _hideBackdrop ? "fixture-hide-backdrop" : null).Trim();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }
    }
}
