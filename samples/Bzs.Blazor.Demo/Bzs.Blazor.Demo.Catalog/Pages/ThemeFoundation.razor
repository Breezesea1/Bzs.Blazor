<PageTitle>@DemoText.ThemeFoundation.PageTitle</PageTitle>

<BzsThemeProvider Mode="@_mode"
                  ModeChanged="SetMode"
                  Density="@_density"
                  DensityChanged="SetDensity"
                  Class="demo-theme-stage demo-external-theme"
                  data-testid="theme-foundation-theme">
    <section class="demo-page" aria-labelledby="theme-title">
        <header class="demo-page-header">
            <p class="demo-eyebrow">@DemoText.ThemeFoundation.Eyebrow</p>
            <h1 id="theme-title">@DemoText.ThemeFoundation.Title</h1>
            <p class="demo-page-summary">
                @DemoText.ThemeFoundation.Summary
            </p>
        </header>

        <section class="demo-panel" aria-label="@DemoText.ThemeFoundation.ControlsAccessibleName">
            <p class="demo-runtime-status" role="status">
                @(_isInteractive ? DemoText.ThemeFoundation.RuntimeReady : DemoText.ThemeFoundation.RuntimeWaiting)
            </p>
            <div class="demo-control-row" role="group" aria-label="@DemoText.ThemeFoundation.ModeGroupAccessibleName">
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_mode == BzsThemeMode.Light)" Click="() => SetMode(BzsThemeMode.Light)">@DemoText.ThemeFoundation.ModeLight</BzsButton>
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_mode == BzsThemeMode.Dark)" Click="() => SetMode(BzsThemeMode.Dark)">@DemoText.ThemeFoundation.ModeDark</BzsButton>
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_mode == BzsThemeMode.System)" Click="() => SetMode(BzsThemeMode.System)">@DemoText.ThemeFoundation.ModeSystem</BzsButton>
            </div>
            <div class="demo-control-row" role="group" aria-label="@DemoText.ThemeFoundation.DensityGroupAccessibleName">
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_density == BzsDensity.Compact)" Click="() => SetDensity(BzsDensity.Compact)">@DemoText.ThemeFoundation.DensityCompact</BzsButton>
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_density == BzsDensity.Comfortable)" Click="() => SetDensity(BzsDensity.Comfortable)">@DemoText.ThemeFoundation.DensityComfortable</BzsButton>
            </div>
            <p class="demo-runtime-status" aria-live="polite">@DemoText.ThemeFoundation.RequestedState(_mode, _density)</p>
            <div class="demo-theme-swatch">@DemoText.ThemeFoundation.ExternalOverrideNote</div>
        </section>
    </section>
</BzsThemeProvider>

@code {
    private BzsThemeMode _mode = BzsThemeMode.Light;
    private BzsDensity _density = BzsDensity.Compact;
    private bool _isInteractive;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            StateHasChanged();
        }
    }

    private Task SetMode(BzsThemeMode mode)
    {
        _mode = mode;
        return Task.CompletedTask;
    }

    private Task SetDensity(BzsDensity density)
    {
        _density = density;
        return Task.CompletedTask;
    }
}
