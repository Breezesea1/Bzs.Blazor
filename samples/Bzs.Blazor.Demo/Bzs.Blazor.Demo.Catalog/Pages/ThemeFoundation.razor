<PageTitle>Theme foundation - Bzs.Blazor</PageTitle>

<BzsThemeProvider Mode="@_mode"
                  ModeChanged="SetMode"
                  Density="@_density"
                  DensityChanged="SetDensity"
                  Class="demo-theme-stage demo-external-theme"
                  data-testid="theme-foundation-theme">
    <section class="demo-page" aria-labelledby="theme-title">
        <header class="demo-page-header">
            <p class="demo-eyebrow">Theme foundation</p>
            <h1 id="theme-title">Light, Dark, and System</h1>
            <p class="demo-page-summary">
                The application owns mode and density while Bzs.Blazor supplies semantic tokens.
            </p>
        </header>

        <section class="demo-panel" aria-label="Theme controls">
            <p class="demo-runtime-status" role="status">
                @(_isInteractive ? "Interactive runtime ready" : "Waiting for interactive runtime")
            </p>
            <div class="demo-control-row" role="group" aria-label="Theme mode">
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_mode == BzsThemeMode.Light)" Click="() => SetMode(BzsThemeMode.Light)">Light</BzsButton>
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_mode == BzsThemeMode.Dark)" Click="() => SetMode(BzsThemeMode.Dark)">Dark</BzsButton>
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_mode == BzsThemeMode.System)" Click="() => SetMode(BzsThemeMode.System)">System</BzsButton>
            </div>
            <div class="demo-control-row" role="group" aria-label="Theme density">
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_density == BzsDensity.Compact)" Click="() => SetDensity(BzsDensity.Compact)">Compact</BzsButton>
                <BzsButton Variant="BzsButtonVariant.Outline" Size="BzsButtonSize.Small" Disabled="@(!_isInteractive)" aria-pressed="@(_density == BzsDensity.Comfortable)" Click="() => SetDensity(BzsDensity.Comfortable)">Comfortable</BzsButton>
            </div>
            <p class="demo-runtime-status" aria-live="polite">Requested mode: @_mode; density: @_density</p>
            <div class="demo-theme-swatch">External custom CSS overrides the semantic primary token.</div>
        </section>
    </section>
</BzsThemeProvider>

@code {
    private BzsThemeMode _mode = BzsThemeMode.Light;
    private BzsDensity _density = BzsDensity.Compact;
    private bool _isInteractive;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            StateHasChanged();
        }
    }

    private Task SetMode(BzsThemeMode mode)
    {
        _mode = mode;
        return Task.CompletedTask;
    }

    private Task SetDensity(BzsDensity density)
    {
        _density = density;
        return Task.CompletedTask;
    }
}
