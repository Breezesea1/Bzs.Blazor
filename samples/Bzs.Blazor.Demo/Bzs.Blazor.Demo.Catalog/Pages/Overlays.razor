@inject IBzsDialogService Dialogs
@inject IBzsToastService Toasts

<PageTitle>@DemoText.Overlays.PageTitle</PageTitle>

<div class="demo-overlays-stage">
    <section class="demo-page" aria-labelledby="overlays-title" data-testid="overlays-workbench">
        <header class="demo-page-header">
            <p class="demo-eyebrow">@DemoText.Overlays.Eyebrow</p>
            <h1 id="overlays-title">@DemoText.Overlays.Title</h1>
            <p class="demo-page-summary">
                @DemoText.Overlays.Summary
            </p>
        </header>

        <p class="demo-runtime-status" role="status" data-testid="overlays-runtime-status">
            @(_isInteractive ? DemoText.Overlays.RuntimeReady : DemoText.Overlays.RuntimeWaiting)
        </p>

        <div class="demo-overlays-workbench-grid">
            <DemoShowcaseSection HeadingId="controlled-dialog-title"
                                 Heading="@DemoText.Overlays.ControlledDialogHeading"
                                 Description="@DemoText.Overlays.ControlledDialogDescription">
                <div class="demo-control-row">
                    <BzsButton Disabled="@(!_isInteractive)"
                               data-testid="open-controlled-dialog"
                               Click="OpenControlledDialog">@DemoText.Overlays.OpenControlledDialog</BzsButton>
                    <BzsCheckbox Id="controlled-dialog-backdrop-policy"
                                 @bind-Value="_allowControlledDialogBackdropDismissal"
                                 Disabled="@(!_isInteractive)"
                                 Label="@DemoText.Overlays.AllowBackdropDismissal" />
                </div>
                <p class="demo-overlays-result" role="status" data-testid="controlled-dialog-status">@_controlledDialogStatus</p>
            </DemoShowcaseSection>

            <DemoShowcaseSection HeadingId="drawer-title"
                                 Heading="@DemoText.Overlays.DrawersHeading"
                                 Description="@DemoText.Overlays.DrawersDescription">
                <div class="demo-control-row">
                    <BzsButton Disabled="@(!_isInteractive)"
                               data-testid="open-modal-drawer"
                               Click="OpenModalDrawer">@DemoText.Overlays.OpenModalDrawer</BzsButton>
                    <BzsButton Disabled="@(!_isInteractive)"
                               Variant="BzsButtonVariant.Outline"
                               data-testid="open-nonmodal-drawer"
                               Click="OpenNonmodalDrawer">@DemoText.Overlays.OpenNonmodalDrawer</BzsButton>
                </div>
                <p class="demo-overlays-result" role="status" data-testid="drawer-status">@_drawerStatus</p>
            </DemoShowcaseSection>

            <DemoShowcaseSection HeadingId="service-dialog-title"
                                 Heading="@DemoText.Overlays.ServiceDialogHeading"
                                 Description="@DemoText.Overlays.ServiceDialogDescription">
                <div class="demo-control-row">
                    <BzsButton Disabled="@(!_isInteractive)"
                               data-testid="open-service-dialog"
                               Click="OpenServiceDialogAsync">@DemoText.Overlays.OpenServiceDialog</BzsButton>
                </div>
                <p class="demo-overlays-result" role="status" data-testid="service-dialog-result">@_serviceDialogResult</p>
            </DemoShowcaseSection>

            <DemoShowcaseSection HeadingId="host-toast-title"
                                 Heading="@DemoText.Overlays.HostToastHeading"
                                 Description="@DemoText.Overlays.HostToastDescription">
                <div class="demo-control-row">
                    <BzsButton Disabled="@(!_isInteractive)"
                               data-testid="show-host-toast"
                               Click="ShowHostToast">@DemoText.Overlays.ShowHostToast</BzsButton>
                </div>
            </DemoShowcaseSection>
        </div>

        <BzsDialog Open="@_isControlledDialogOpen"
                   OpenChanged="SetControlledDialogOpen"
                   Title="@DemoText.Overlays.ControlledDialogHeading"
                   AccessibleName="@DemoText.Overlays.ControlledDialogHeading"
                   Modal="true"
                   CloseOnEscape="true"
                   CloseOnBackdropClick="@_allowControlledDialogBackdropDismissal"
                   ShowCloseButton="false"
                   InitialFocusSelector="#controlled-dialog-primary"
                   Dismissed="HandleControlledDialogDismissed"
                   data-testid="controlled-dialog">
            <p class="demo-overlays-dialog-copy">@DemoText.Overlays.ControlledDialogBody</p>
            <div class="demo-overlays-dialog-actions">
                <BzsButton Id="controlled-dialog-primary"
                           data-testid="controlled-dialog-primary"
                           Click="CompleteControlledDialog">@DemoText.Overlays.CompleteControlledDialog</BzsButton>
                <BzsButton Id="controlled-dialog-cancel"
                           data-testid="controlled-dialog-cancel"
                           Variant="BzsButtonVariant.Outline"
                           Click="CancelControlledDialog">@DemoText.Overlays.CancelControlledDialog</BzsButton>
                <BzsButton Id="controlled-dialog-nested-service"
                           data-testid="open-nested-service-dialog"
                           Variant="BzsButtonVariant.Secondary"
                           Click="OpenServiceDialogAsync">@DemoText.Overlays.OpenNestedServiceDialog</BzsButton>
            </div>
        </BzsDialog>

        <BzsDrawer Open="@_isModalDrawerOpen"
                   OpenChanged="SetModalDrawerOpen"
                   Title="@DemoText.Overlays.ModalDrawerTitle"
                   AccessibleName="@DemoText.Overlays.ModalDrawerTitle"
                   Modal="true"
                   Placement="BzsDrawerPlacement.End"
                   CloseOnEscape="true"
                   CloseOnBackdropClick="true"
                   ShowCloseButton="false"
                   InitialFocusSelector="#modal-drawer-close"
                   Dismissed="HandleModalDrawerDismissed"
                   data-testid="modal-drawer">
            <p class="demo-overlays-dialog-copy">@DemoText.Overlays.ModalDrawerBody</p>
            <div class="demo-overlays-dialog-actions">
                <BzsButton Id="modal-drawer-close"
                           data-testid="close-modal-drawer"
                           Click="CloseModalDrawer">@DemoText.Overlays.CloseModalDrawer</BzsButton>
            </div>
        </BzsDrawer>

        <BzsDrawer Open="@_isNonmodalDrawerOpen"
                   OpenChanged="SetNonmodalDrawerOpen"
                   Title="@DemoText.Overlays.NonmodalDrawerTitle"
                   AccessibleName="@DemoText.Overlays.NonmodalDrawerTitle"
                   Modal="false"
                   Placement="BzsDrawerPlacement.Start"
                   CloseOnEscape="true"
                   ShowCloseButton="false"
                   InitialFocusSelector="#nonmodal-drawer-close"
                   Dismissed="HandleNonmodalDrawerDismissed"
                   data-testid="nonmodal-drawer">
            <p class="demo-overlays-dialog-copy">@DemoText.Overlays.NonmodalDrawerBody</p>
            <div class="demo-overlays-dialog-actions">
                <BzsButton Id="nonmodal-drawer-close"
                           data-testid="close-nonmodal-drawer"
                           Click="CloseNonmodalDrawer">@DemoText.Overlays.CloseNonmodalDrawer</BzsButton>
            </div>
        </BzsDrawer>

        <BzsOverlayHost data-testid="overlays-host" />
    </section>
</div>

@code {
    private bool _allowControlledDialogBackdropDismissal;
    private bool _isControlledDialogOpen;
    private bool _isModalDrawerOpen;
    private bool _isNonmodalDrawerOpen;
    private bool _isInteractive;
    private string _controlledDialogStatus = DemoText.Overlays.ControlledDialogClosed;
    private string _drawerStatus = DemoText.Overlays.NoDrawerOpen;
    private string _serviceDialogResult = DemoText.Overlays.NoServiceDialogResult;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            StateHasChanged();
        }
    }

    private Task OpenControlledDialog()
    {
        _isControlledDialogOpen = true;
        _controlledDialogStatus = _allowControlledDialogBackdropDismissal
            ? DemoText.Overlays.ControlledDialogOpenBackdropAllowed
            : DemoText.Overlays.ControlledDialogOpenBackdropDisabled;
        return Task.CompletedTask;
    }

    private Task SetControlledDialogOpen(bool open)
    {
        _isControlledDialogOpen = open;
        return Task.CompletedTask;
    }

    private Task CompleteControlledDialog()
    {
        _isControlledDialogOpen = false;
        _controlledDialogStatus = DemoText.Overlays.ControlledDialogCompleted;
        return Task.CompletedTask;
    }

    private Task CancelControlledDialog()
    {
        _isControlledDialogOpen = false;
        _controlledDialogStatus = DemoText.Overlays.ControlledDialogCancelled;
        return Task.CompletedTask;
    }

    private Task HandleControlledDialogDismissed(BzsDialogDismissReason reason)
    {
        _controlledDialogStatus = DemoText.Overlays.ControlledDialogDismissedBy(reason);
        return Task.CompletedTask;
    }

    private Task OpenModalDrawer()
    {
        _isModalDrawerOpen = true;
        _drawerStatus = DemoText.Overlays.ModalDrawerOpen;
        return Task.CompletedTask;
    }

    private Task SetModalDrawerOpen(bool open)
    {
        _isModalDrawerOpen = open;
        return Task.CompletedTask;
    }

    private Task CloseModalDrawer()
    {
        _isModalDrawerOpen = false;
        _drawerStatus = DemoText.Overlays.ModalDrawerClosed;
        return Task.CompletedTask;
    }

    private Task HandleModalDrawerDismissed(BzsDialogDismissReason reason)
    {
        _drawerStatus = DemoText.Overlays.ModalDrawerDismissedBy(reason);
        return Task.CompletedTask;
    }

    private Task OpenNonmodalDrawer()
    {
        _isNonmodalDrawerOpen = true;
        _drawerStatus = DemoText.Overlays.NonmodalDrawerOpen;
        return Task.CompletedTask;
    }

    private Task SetNonmodalDrawerOpen(bool open)
    {
        _isNonmodalDrawerOpen = open;
        return Task.CompletedTask;
    }

    private Task CloseNonmodalDrawer()
    {
        _isNonmodalDrawerOpen = false;
        _drawerStatus = DemoText.Overlays.NonmodalDrawerClosed;
        return Task.CompletedTask;
    }

    private Task HandleNonmodalDrawerDismissed(BzsDialogDismissReason reason)
    {
        _drawerStatus = DemoText.Overlays.NonmodalDrawerDismissedBy(reason);
        return Task.CompletedTask;
    }

    private async Task OpenServiceDialogAsync()
    {
        var result = await Dialogs.ShowAsync<OverlayResultDialog, bool>(
            parameters => parameters.Add(
                component => component.Prompt,
                DemoText.Overlays.ServiceDialogPrompt),
            new BzsDialogOptions
            {
                Title = DemoText.Overlays.ServiceDialogTitle,
                AccessibleName = DemoText.Overlays.ServiceDialogTitle,
                Modal = true,
                CloseOnEscape = true,
                CloseOnBackdropClick = true,
                ShowCloseButton = false,
                InitialFocusSelector = "#service-dialog-complete",
            });

        _serviceDialogResult = result.IsCompleted
            ? DemoText.Overlays.ServiceDialogCompleted(result.Value == true)
            : DemoText.Overlays.ServiceDialogResultKind(result.Kind);
    }

    private void ShowHostToast()
    {
        Toasts.Show(new BzsToastOptions
        {
            Title = DemoText.Overlays.HostToastTitle,
            Message = DemoText.Overlays.HostToastMessage,
            Severity = BzsToastSeverity.Success,
            Duration = Timeout.InfiniteTimeSpan,
            AccessibleName = DemoText.Overlays.HostToastAccessibleName,
        });
    }
}
