<PageTitle>@DemoText.Tabs.PageTitle</PageTitle>

<div class="demo-tabs-stage">
    <section class="demo-page" aria-labelledby="tabs-title" data-testid="tabs-workbench">
        <header class="demo-page-header">
            <p class="demo-eyebrow">@DemoText.Tabs.Eyebrow</p>
            <h1 id="tabs-title">@DemoText.Tabs.Title</h1>
            <p class="demo-page-summary">
                @DemoText.Tabs.Summary
            </p>
        </header>

        <p class="demo-runtime-status" role="status" data-testid="tabs-runtime-status">
            @(_isInteractive ? DemoText.Tabs.RuntimeReady : DemoText.Tabs.RuntimeWaiting)
        </p>

        <section class="demo-panel demo-tabs-workbench" aria-label="@DemoText.Tabs.ExamplesAccessibleName">
            <DemoShowcaseSection Class="demo-tabs-section"
                                 HeadingId="automatic-tabs-title"
                                 Heading="@DemoText.Tabs.AutomaticHeading"
                                 Description="@DemoText.Tabs.AutomaticDescription">
                <BzsTabs ActiveValue="@_automaticActiveValue"
                         ActiveValueChanged="SetAutomaticActiveValue"
                         Orientation="BzsTabsOrientation.Horizontal"
                         ActivationMode="BzsTabActivationMode.Automatic"
                         aria-label="@DemoText.Tabs.AutomaticTabsAccessibleName"
                         data-testid="automatic-tabs">
                    <BzsTabItem Value="overview" Title="@DemoText.Tabs.OverviewTab" data-testid="automatic-overview">
                        <p class="demo-tabs-panel-copy">@DemoText.Tabs.OverviewPanel</p>
                    </BzsTabItem>
                    <BzsTabItem Value="schedule" Title="@DemoText.Tabs.ScheduleTab" Disabled="true" data-testid="automatic-schedule">
                        <p class="demo-tabs-panel-copy">@DemoText.Tabs.SchedulePanel</p>
                    </BzsTabItem>
                    <BzsTabItem Value="activity" Title="@DemoText.Tabs.ActivityTab" data-testid="automatic-activity">
                        <p class="demo-tabs-panel-copy">@DemoText.Tabs.ActivityPanel</p>
                    </BzsTabItem>
                </BzsTabs>
                <p class="demo-tabs-selection" aria-live="polite" data-testid="automatic-selection">@DemoText.Tabs.SelectedValue(_automaticActiveValue)</p>
            </DemoShowcaseSection>

            <DemoShowcaseSection Class="demo-tabs-section"
                                 HeadingId="manual-tabs-title"
                                 Heading="@DemoText.Tabs.ManualHeading"
                                 Description="@DemoText.Tabs.ManualDescription">
                <BzsTabs ActiveValue="@_manualActiveValue"
                         ActiveValueChanged="SetManualActiveValue"
                         Orientation="BzsTabsOrientation.Vertical"
                         ActivationMode="BzsTabActivationMode.Manual"
                         aria-label="@DemoText.Tabs.ManualTabsAccessibleName"
                         data-testid="manual-tabs">
                    <BzsTabItem Value="profile" Title="@DemoText.Tabs.ProfileTab" data-testid="manual-profile">
                        <p class="demo-tabs-panel-copy">@DemoText.Tabs.ProfilePanel</p>
                    </BzsTabItem>
                    <BzsTabItem Value="preferences" Title="@DemoText.Tabs.PreferencesTab" data-testid="manual-preferences">
                        <p class="demo-tabs-panel-copy">@DemoText.Tabs.PreferencesPanel</p>
                    </BzsTabItem>
                    <BzsTabItem Value="security" Title="@DemoText.Tabs.SecurityTab" data-testid="manual-security">
                        <p class="demo-tabs-panel-copy">@DemoText.Tabs.SecurityPanel</p>
                    </BzsTabItem>
                </BzsTabs>
                <p class="demo-tabs-selection" aria-live="polite" data-testid="manual-selection">@DemoText.Tabs.SelectedValue(_manualActiveValue)</p>
            </DemoShowcaseSection>

            @* The three specimens below are the demonstration itself: each shows the component under a
               specific language and writing direction, so their titles and panel copy stay in that
               language instead of following the visitor's culture. *@
            <div class="demo-tabs-locale-grid">
                <DemoShowcaseSection Class="demo-tabs-section"
                                     lang="en"
                                     HeadingId="english-tabs-title"
                                     Heading="English">
                    <BzsTabs InitialActiveValue="details" lang="en" aria-label="English content tabs" data-testid="english-tabs">
                        <BzsTabItem Value="details" Title="Details">
                            <p class="demo-tabs-panel-copy">Project details use English application content.</p>
                        </BzsTabItem>
                        <BzsTabItem Value="history" Title="History">
                            <p class="demo-tabs-panel-copy">History records approvals and delivery notes.</p>
                        </BzsTabItem>
                    </BzsTabs>
                </DemoShowcaseSection>

                <DemoShowcaseSection Class="demo-tabs-section"
                                     lang="zh-Hans"
                                     HeadingId="chinese-tabs-title"
                                     Heading="简体中文">
                    <BzsTabs InitialActiveValue="summary" lang="zh-Hans" aria-label="中文内容选项卡" data-testid="chinese-tabs">
                        <BzsTabItem Value="summary" Title="概览">
                            <p class="demo-tabs-panel-copy">项目概览包含当前进度、负责人和下一次评审日期。</p>
                        </BzsTabItem>
                        <BzsTabItem Value="delivery" Title="交付">
                            <p class="demo-tabs-panel-copy">交付记录会保留已批准的版本和发布说明。</p>
                        </BzsTabItem>
                    </BzsTabs>
                </DemoShowcaseSection>
            </div>

            <DemoShowcaseSection Class="demo-tabs-section"
                                 dir="rtl"
                                 lang="ar"
                                 HeadingId="rtl-tabs-title"
                                 Heading="علامات تبويب من اليمين إلى اليسار"
                                 Description="@DemoText.Tabs.RtlDescription">
                <BzsTabs ActiveValue="@_rtlActiveValue"
                         ActiveValueChanged="SetRtlActiveValue"
                         Orientation="BzsTabsOrientation.Horizontal"
                         ActivationMode="BzsTabActivationMode.Automatic"
                         aria-label="RTL workflow tabs"
                         data-testid="rtl-tabs">
                    <BzsTabItem Value="summary" Title="ملخص" data-testid="rtl-summary">
                        <p class="demo-tabs-panel-copy">ملخص سير العمل ومواعيد المراجعة الحالية.</p>
                    </BzsTabItem>
                    <BzsTabItem Value="review" Title="مراجعة" data-testid="rtl-review">
                        <p class="demo-tabs-panel-copy">حالة المراجعة والمالكون المطلوبون للتسليم.</p>
                    </BzsTabItem>
                    <BzsTabItem Value="decisions" Title="قرارات" data-testid="rtl-decisions">
                        <p class="demo-tabs-panel-copy">القرارات المعتمدة وخطوات النشر التالية.</p>
                    </BzsTabItem>
                </BzsTabs>
                <p class="demo-tabs-selection" aria-live="polite" data-testid="rtl-selection">المحدد: @_rtlActiveValue</p>
            </DemoShowcaseSection>
        </section>
    </section>
</div>

@code {
    private string _automaticActiveValue = "overview";
    private string _manualActiveValue = "profile";
    private string _rtlActiveValue = "summary";
    private bool _isInteractive;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            StateHasChanged();
        }
    }

    private Task SetAutomaticActiveValue(string value)
    {
        _automaticActiveValue = value;
        return Task.CompletedTask;
    }

    private Task SetManualActiveValue(string value)
    {
        _manualActiveValue = value;
        return Task.CompletedTask;
    }

    private Task SetRtlActiveValue(string value)
    {
        _rtlActiveValue = value;
        return Task.CompletedTask;
    }
}
