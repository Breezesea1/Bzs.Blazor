@implements IAsyncDisposable
@inject IBzsToastService ToastService

<PageTitle>@DemoText.Feedback.PageTitle</PageTitle>

<div class="demo-feedback-stage">
    <section class="demo-page" aria-labelledby="feedback-title">
        <header class="demo-page-header">
            <p class="demo-eyebrow">@DemoText.Feedback.Eyebrow</p>
            <h1 id="feedback-title">@DemoText.Feedback.Title</h1>
            <p class="demo-page-summary">
                @DemoText.Feedback.Summary
            </p>
        </header>

        <p class="demo-runtime-status" role="status">
            @(_isInteractive ? DemoText.Feedback.RuntimeReady : DemoText.Feedback.RuntimeWaiting)
        </p>

        <DemoShowcaseSection HeadingId="message-title" Heading="@DemoText.Feedback.MessageHeading">
            <div class="demo-feedback-message-stack">
                <BzsMessage Severity="BzsMessageSeverity.Information" Title="@DemoText.Feedback.MessageInformationTitle">@DemoText.Feedback.MessageInformationBody</BzsMessage>
                <BzsMessage Severity="BzsMessageSeverity.Success" Title="@DemoText.Feedback.MessageSuccessTitle">@DemoText.Feedback.MessageSuccessBody</BzsMessage>
                <BzsMessage Severity="BzsMessageSeverity.Warning" Title="@DemoText.Feedback.MessageWarningTitle">@DemoText.Feedback.MessageWarningBody</BzsMessage>
                <BzsMessage Severity="BzsMessageSeverity.Error" Title="@DemoText.Feedback.MessageErrorTitle">@DemoText.Feedback.MessageErrorBody</BzsMessage>
            </div>
        </DemoShowcaseSection>

        <DemoShowcaseSection HeadingId="progress-title" Heading="@DemoText.Feedback.ProgressHeading">
            <div class="demo-feedback-progress-grid">
                <BzsProgress Label="@DemoText.Feedback.ProgressPublishing" Value="64" />
                <BzsProgress Label="@DemoText.Feedback.ProgressChecking" />
            </div>
        </DemoShowcaseSection>

        <DemoShowcaseSection HeadingId="toast-title" Heading="@DemoText.Feedback.ToastHeading">
            <div class="demo-feedback-toast-controls" role="group" aria-label="@DemoText.Feedback.ToastExamplesAccessibleName">
                <BzsButton Disabled="@(!_isInteractive)" Click="ShowTimedToast">@DemoText.Feedback.ShowTimedToast</BzsButton>
                <BzsButton Disabled="@(!_isInteractive)" Variant="BzsButtonVariant.Outline" Click="ShowPersistentToast">@DemoText.Feedback.ShowPersistentToast</BzsButton>
                <BzsButton Disabled="@(!_isInteractive)" Variant="BzsButtonVariant.Danger" Click="ShowErrorToast">@DemoText.Feedback.ShowErrorToast</BzsButton>
            </div>

            <div class="demo-feedback-toast-list" aria-label="@DemoText.Feedback.ActiveToastExamplesAccessibleName">
                @if (_toasts.Count == 0)
                {
                    <p class="demo-feedback-empty">@DemoText.Feedback.NoActiveNotifications</p>
                }
                @foreach (var toast in _toasts)
                {
                    <BzsToast @key="toast.Id"
                              Toast="toast"
                              DismissRequested="reason => DismissToast(toast.Id, reason)"
                              PauseRequested="reason => PauseToast(toast.Id, reason)"
                              ResumeRequested="reason => ResumeToast(toast.Id, reason)" />
                }
            </div>
        </DemoShowcaseSection>
    </section>
</div>

@code {
    private IReadOnlyList<BzsToastSnapshot> _toasts = [];
    private bool _isInteractive;

    protected override void OnInitialized()
    {
        _toasts = ToastService.Snapshot;
        ToastService.Changed += HandleToastChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            StateHasChanged();
        }
    }

    private void ShowTimedToast()
    {
        ToastService.Show(new BzsToastOptions
        {
            Title = DemoText.Feedback.TimedToastTitle,
            Message = DemoText.Feedback.TimedToastMessage,
            Severity = BzsToastSeverity.Information,
            Duration = TimeSpan.FromMilliseconds(1500),
            AccessibleName = DemoText.Feedback.TimedToastAccessibleName,
        });
    }

    private void ShowPersistentToast()
    {
        ToastService.Show(new BzsToastOptions
        {
            Title = DemoText.Feedback.PersistentToastTitle,
            Message = DemoText.Feedback.PersistentToastMessage,
            Severity = BzsToastSeverity.Success,
            Duration = Timeout.InfiniteTimeSpan,
            AccessibleName = DemoText.Feedback.PersistentToastAccessibleName,
        });
    }

    private void ShowErrorToast()
    {
        ToastService.Show(new BzsToastOptions
        {
            Title = DemoText.Feedback.ErrorToastTitle,
            Message = DemoText.Feedback.ErrorToastMessage,
            Severity = BzsToastSeverity.Error,
            Duration = Timeout.InfiniteTimeSpan,
            AccessibleName = DemoText.Feedback.ErrorToastAccessibleName,
        });
    }

    private Task DismissToast(BzsToastId id, BzsToastDismissReason reason)
    {
        ToastService.Dismiss(id, reason);
        return Task.CompletedTask;
    }

    private Task PauseToast(BzsToastId id, BzsToastPauseReason reason)
    {
        ToastService.Pause(id, reason);
        return Task.CompletedTask;
    }

    private Task ResumeToast(BzsToastId id, BzsToastPauseReason reason)
    {
        ToastService.Resume(id, reason);
        return Task.CompletedTask;
    }

    private async void HandleToastChanged(object? sender, BzsToastChangedEventArgs args)
    {
        try
        {
            await InvokeAsync(() =>
            {
                _toasts = args.Snapshot;
                StateHasChanged();
            });
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    public ValueTask DisposeAsync()
    {
        ToastService.Changed -= HandleToastChanged;
        return ValueTask.CompletedTask;
    }
}
