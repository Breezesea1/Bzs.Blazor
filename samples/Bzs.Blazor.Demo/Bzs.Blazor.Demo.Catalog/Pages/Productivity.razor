@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Bzs.Blazor
@inject DemoDestinationLinks Links

<PageTitle>Productivity components - Bzs.Blazor</PageTitle>

<section class="demo-page"
         aria-labelledby="productivity-title"
         data-testid="productivity-workbench"
         data-bzs-renderer="@RendererInfo.Name.ToLowerInvariant()"
         data-bzs-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <header class="demo-page-header">
        <p class="demo-eyebrow">Productivity components</p>
        <h1 id="productivity-title">Operational workbench</h1>
        <p class="demo-page-summary">
            The new navigation, overlay, status, asynchronous input, upload, and typed DataGrid contracts in one usable workflow.
        </p>
    </header>

    <BzsBreadcrumbs Items="@BreadcrumbItems" AccessibleName="Productivity breadcrumb" />

    <DemoShowcaseSection HeadingId="navigation-specimen-title"
                         Heading="Navigation and status"
                         Description="Links, disclosure groups, counts, identities, loading placeholders, and controlled chips.">
        <div class="demo-control-row">
            <BzsNavMenu AccessibleName="Workbench navigation">
                <BzsNavItem Label="Overview" Href="@Links.To(DemoCatalogDestinations.Overview)" Match="NavLinkMatch.All" Icon="@BzsIcons.Package" />
                <BzsNavItem Label="Productivity" Href="@Links.To(DemoCatalogDestinations.Productivity)" Active="true" Icon="@BzsIcons.Package" />
                <BzsNavItem Label="Review queue"
                            Open="@_reviewQueueOpen"
                            OpenChanged="value => _reviewQueueOpen = value"
                            Icon="@BzsIcons.Menu">
                    <ChildContent>
                        <BzsNavItem Label="Assigned" Href="@Links.To(DemoCatalogDestinations.Productivity, "view=assigned")" />
                        <BzsNavItem Label="Waiting" Href="@Links.To(DemoCatalogDestinations.Productivity, "view=waiting")" />
                    </ChildContent>
                </BzsNavItem>
            </BzsNavMenu>
        </div>
        <div class="demo-control-row" aria-label="Status primitives">
            <BzsAvatar Initials="AS"
                       Name="Alicia Santos"
                       Size="BzsAvatarSize.Medium"
                       Shape="BzsAvatarShape.Rounded" />
            <BzsBadge Severity="BzsMessageSeverity.Success" Count="7" AccessibleName="Seven open reviews" />
            @if (_chipVisible)
            {
                <BzsChip Selectable="true"
                         Selected="@_chipSelected"
                         SelectedChanged="value => _chipSelected = value"
                         Removable="true"
                         RemoveAccessibleName="Remove review filter"
                         RemoveRequested="RemoveChip">
                    Needs review
                </BzsChip>
            }
            <BzsSkeleton Class="demo-status-skeleton" Shape="BzsSkeletonShape.Text" Size="BzsSkeletonSize.Small" />
        </div>
        <BzsPagination Page="@_page" PageCount="6" PageChanged="value => _page = value" AccessibleName="Review pages" />
    </DemoShowcaseSection>

    <DemoShowcaseSection HeadingId="overlay-specimen-title"
                         Heading="Anchored commands"
                         Description="Popover, Tooltip, menu, and context-menu all retain passive markup before interactivity.">
        <div class="demo-control-row">
            <BzsTooltip Text="Shows the keyboard and pointer contract"
                        ShowDelay="@TimeSpan.Zero"
                        HideDelay="@TimeSpan.Zero">
                <TriggerContent Context="trigger">
                    <BzsButton Variant="BzsButtonVariant.Secondary"
                               Class="demo-inline-command"
                               data-testid="productivity-tooltip-trigger"
                               @attributes="trigger.Attributes">Focus me</BzsButton>
                </TriggerContent>
            </BzsTooltip>
            <BzsPopover Open="@_popoverOpen"
                        OpenChanged="value => _popoverOpen = value"
                        TriggerAccessibleName="Open review details"
                        ContentRole="dialog"
                        ContentAccessibleName="Review details"
                        data-testid="productivity-popover">
                <TriggerContent><span>Review details</span></TriggerContent>
                <ChildContent><p>Two reviewers are waiting for a response.</p></ChildContent>
            </BzsPopover>
            <BzsMenu Open="@_menuOpen"
                     OpenChanged="value => _menuOpen = value"
                     TriggerAccessibleName="Open review actions"
                     AccessibleName="Review actions"
                     data-testid="productivity-menu">
                <TriggerContent><span>Actions</span></TriggerContent>
                <ChildContent>
                    <BzsMenuItem Text="Mark ready" Activated="MarkReady" />
                    <BzsMenuItem Text="Assign reviewer" Activated="AssignReviewer" />
                    <BzsMenuItem Separator="true" />
                    <BzsMenuItem Text="Archive" Disabled="true" />
                </ChildContent>
            </BzsMenu>
            <BzsContextMenu Open="@_contextMenuOpen"
                            OpenChanged="value => _contextMenuOpen = value"
                            TargetAccessibleName="Review row actions"
                            AccessibleName="Review row actions">
                <TargetContent><div class="demo-context-target">Right-click this review</div></TargetContent>
                <ChildContent>
                    <BzsMenuItem Text="Open review" Activated="OpenReview" />
                    <BzsMenuItem Text="Copy link" Activated="CopyReviewLink" />
                </ChildContent>
            </BzsContextMenu>
        </div>
        <p class="demo-runtime-status" role="status">@_commandStatus</p>
    </DemoShowcaseSection>

    <EditForm Model="@_form" FormName="productivity-workbench" class="demo-panel">
        <DataAnnotationsValidator />
        <header class="demo-showcase-section-header">
            <h2 id="input-specimen-title">Asynchronous input and file selection</h2>
            <p>Suggestions are provider-owned; selected browser files are validated and remain transport-owned by the consumer.</p>
        </header>
        <div class="demo-form-grid">
            <BzsAutocomplete TValue="string"
                             Id="review-owner"
                             @bind-Value="_form.Owner"
                             Provider="@_ownerProvider"
                             Label="Review owner"
                             Description="Type a name to load suggestions."
                             MinimumQueryLength="1"
                             DebounceDelay="@TimeSpan.FromMilliseconds(120)"
                             data-testid="productivity-owner" />
            <BzsFileUpload Id="review-attachments"
                           @bind-Value="_form.Files"
                           Label="Attachments"
                           Description="Select up to three review files."
                           Multiple="true"
                           MaximumFileCount="3"
                           Accept=".pdf,.png,.jpg"
                           data-testid="productivity-upload" />
        </div>
    </EditForm>

    <DemoShowcaseSection HeadingId="grid-specimen-title"
                         Heading="@DemoText.Productivity.DataGridTitle"
                         Description="@DemoText.Productivity.DataGridDescription">
        <BzsDataGrid TItem="ReviewRow"
                     @ref="_grid"
                     Provider="@_gridProvider"
                     Page="@_gridPage"
                     PageChanged="value => _gridPage = value"
                     PageSize="@_gridPageSize"
                     PageSizeChanged="value => _gridPageSize = value"
                     PageSizeOptions="@_gridPageSizeOptions"
                     Sort="@_gridSort"
                     SortChanged="value => _gridSort = value"
                     Filters="@_gridFilters"
                     FiltersChanged="value => _gridFilters = value"
                     ShowPageSizeSelector="false"
                     ShowResultSummary="true"
                     ItemKey="row => row.Id"
                     SelectionMode="BzsDataGridSelectionMode.Multiple"
                     ShowSelectAll="true"
                     SelectAllText="@DemoText.Productivity.SelectCurrentPage"
                     SelectedItems="@_selectedRows"
                     SelectedItemsChanged="HandleGridSelectionChanged"
                     Caption="@DemoText.Productivity.ReviewQueue"
                     AccessibleName="@DemoText.Productivity.ReviewQueue"
                     data-testid="productivity-grid">
            <ToolbarContent>
                <BzsButton Variant="BzsButtonVariant.Outline"
                           Size="BzsButtonSize.Small"
                           StartIcon="BzsIcons.Refresh"
                           Click="RefreshGridAsync"
                           AccessibleName="@DemoText.Productivity.RefreshGridAccessibleName"
                           data-testid="productivity-grid-refresh">@DemoText.Productivity.RefreshGrid</BzsButton>
                <span class="demo-runtime-status"
                      role="status"
                      data-testid="productivity-grid-refresh-status">@GridRefreshStatus</span>
            </ToolbarContent>
            <ChildContent>
                <BzsDataGridColumn TItem="ReviewRow"
                                   Key="title"
                                   Title="@DemoText.Productivity.ReviewColumn"
                                   ValueSelector="row => row.Title"
                                   Sortable="true"
                                   FilterKind="BzsDataGridFilterKind.Text" />
                <BzsDataGridColumn TItem="ReviewRow"
                                   Key="owner"
                                   Title="@DemoText.Productivity.OwnerColumn"
                                   ValueSelector="row => row.Owner"
                                   Sortable="true"
                                   FilterKind="BzsDataGridFilterKind.Text" />
                <BzsDataGridColumn TItem="ReviewRow"
                                   Key="priority"
                                   Title="@DemoText.Productivity.PriorityColumn"
                                   ValueSelector="row => row.Priority"
                                   Sortable="true"
                                   FilterKind="BzsDataGridFilterKind.Text">
                    <CellTemplate Context="row">
                        <span class="demo-grid-priority" data-priority="@row.Priority.ToLowerInvariant()">
                            @row.Priority
                        </span>
                    </CellTemplate>
                </BzsDataGridColumn>
            </ChildContent>
        </BzsDataGrid>
        <div class="demo-data-grid-examples">
            <DemoShowcaseSection Class="demo-data-grid-example demo-data-grid-example--wide"
                                 HeadingLevel="3"
                                 HeadingId="workbench-grid-title"
                                 Heading="@DemoText.Productivity.WorkbenchGridTitle"
                                 Description="@DemoText.Productivity.WorkbenchGridDescription">
                <BzsDataGrid TItem="WorkbenchRow"
                             Items="@WorkbenchRows"
                             ClientFiltering="true"
                             Page="@_workbenchPage"
                             PageChanged="value => _workbenchPage = value"
                             PageSize="@_workbenchPageSize"
                             PageSizeChanged="value => _workbenchPageSize = value"
                             PageSizeOptions="@WorkbenchPageSizeOptions"
                             MultiSort="true"
                             Sorts="@_workbenchSorts"
                             SortsChanged="value => _workbenchSorts = value"
                             Filters="@_workbenchFilters"
                             FiltersChanged="value => _workbenchFilters = value"
                             SearchText="@_workbenchSearch"
                             SearchTextChanged="value => _workbenchSearch = value"
                             SearchTextLabel="@DemoText.Productivity.GridSearchLabel"
                             ShowSearch="true"
                             ShowColumnChooser="true"
                             ColumnChooserText="@DemoText.Productivity.GridColumnChooser"
                             HiddenColumnKeys="@_workbenchHiddenColumns"
                             HiddenColumnKeysChanged="value => _workbenchHiddenColumns = value"
                             Density="BzsDataGridDensity.Comfortable"
                             Striped="true"
                             Bordered="true"
                             StickyHeader="true"
                             ResizableColumns="true"
                             ShowResultSummary="true"
                             ItemKey="row => row.Id"
                             ExpandedItemKeys="@_workbenchExpandedRows"
                             ExpandedItemKeysChanged="value => _workbenchExpandedRows = value"
                             Caption="@DemoText.Productivity.WorkbenchGridCaption"
                             AccessibleName="@DemoText.Productivity.WorkbenchGridCaption"
                             data-testid="productivity-workbench-grid">
                    <DetailTemplate Context="row">
                        <dl class="demo-grid-detail">
                            <dt>@DemoText.Productivity.DetailStatus</dt>
                            <dd>@row.Status</dd>
                            <dt>@DemoText.Productivity.DetailNotes</dt>
                            <dd>@row.Notes</dd>
                        </dl>
                    </DetailTemplate>
                    <ChildContent>
                        <BzsDataGridColumn TItem="WorkbenchRow"
                                           Key="title"
                                           Title="@DemoText.Productivity.ReviewColumn"
                                           ValueSelector="row => row.Title"
                                           Sortable="true"
                                           FilterKind="BzsDataGridFilterKind.Text"
                                           MinWidth="12rem"
                                           Sticky="BzsDataGridColumnSticky.Start"
                                           Aggregate="BzsDataGridAggregate.Count"
                                           Hideable="false" />
                        <BzsDataGridColumn TItem="WorkbenchRow"
                                           Key="owner"
                                           Title="@DemoText.Productivity.OwnerColumn"
                                           ValueSelector="row => row.Owner"
                                           Sortable="true"
                                           FilterKind="BzsDataGridFilterKind.Choice"
                                           FilterChoices="@WorkbenchOwners"
                                           Width="10rem" />
                        <BzsDataGridColumn TItem="WorkbenchRow"
                                           Key="status"
                                           Title="@DemoText.Productivity.StatusColumn"
                                           ValueSelector="row => row.Status"
                                           Sortable="true"
                                           FilterKind="BzsDataGridFilterKind.Text"
                                           Align="BzsDataGridAlignment.Center"
                                           Width="8rem" />
                        <BzsDataGridColumn TItem="WorkbenchRow"
                                           Key="hours"
                                           Title="@DemoText.Productivity.HoursColumn"
                                           ValueSelector="row => row.Hours"
                                           Sortable="true"
                                           FilterKind="BzsDataGridFilterKind.Number"
                                           Align="BzsDataGridAlignment.End"
                                           Width="7rem"
                                           Aggregate="BzsDataGridAggregate.Sum"
                                           AggregateValueSelector="row => row.Hours" />
                        <BzsDataGridColumn TItem="WorkbenchRow"
                                           Key="due"
                                           Title="@DemoText.Productivity.DueColumn"
                                           ValueSelector="row => row.Due"
                                           Format="yyyy-MM-dd"
                                           Sortable="true"
                                           FilterKind="BzsDataGridFilterKind.Date"
                                           Align="BzsDataGridAlignment.End"
                                           Width="9rem" />
                    </ChildContent>
                </BzsDataGrid>
            </DemoShowcaseSection>
            <DemoShowcaseSection Class="demo-data-grid-example"
                                 HeadingLevel="3"
                                 HeadingId="page-size-only-grid-title"
                                 Heading="@DemoText.Productivity.PageSizeOnlyGridTitle"
                                 Description="@DemoText.Productivity.PageSizeOnlyGridDescription">
                <BzsDataGrid TItem="ReviewRow"
                             Items="@CompactGridRows"
                             PageSize="@_pageSizeOnlyGridPageSize"
                             PageSizeChanged="value => _pageSizeOnlyGridPageSize = value"
                             PageSizeOptions="@PageSizeOnlyGridOptions"
                             ShowPageSizeSelector="true"
                             ShowPagination="false"
                             Caption="@DemoText.Productivity.PageSizeOnlyGridTitle"
                             AccessibleName="@DemoText.Productivity.PageSizeOnlyGridTitle"
                             data-testid="productivity-page-size-only-grid">
                    <BzsDataGridColumn TItem="ReviewRow"
                                       Key="title"
                                       Title="@DemoText.Productivity.CompactGridReviewColumn"
                                       ValueSelector="row => row.Title" />
                    <BzsDataGridColumn TItem="ReviewRow"
                                       Key="owner"
                                       Title="@DemoText.Productivity.CompactGridOwnerColumn"
                                       ValueSelector="row => row.Owner" />
                </BzsDataGrid>
            </DemoShowcaseSection>
            <DemoShowcaseSection Class="demo-data-grid-example"
                                 HeadingLevel="3"
                                 HeadingId="compact-grid-title"
                                 Heading="@DemoText.Productivity.CompactGridTitle"
                                 Description="@DemoText.Productivity.CompactGridDescription">
                <BzsDataGrid TItem="ReviewRow"
                             Items="@CompactGridRows"
                             PageSize="5"
                             PageSizeOptions="@_gridPageSizeOptions"
                             ShowPageSizeSelector="false"
                             ShowPagination="false"
                             ShowResultSummary="false"
                             Caption="@DemoText.Productivity.CompactGridTitle"
                             AccessibleName="@DemoText.Productivity.CompactGridTitle"
                             data-testid="productivity-compact-grid">
                    <BzsDataGridColumn TItem="ReviewRow"
                                       Key="title"
                                       Title="@DemoText.Productivity.CompactGridReviewColumn"
                                       ValueSelector="row => row.Title" />
                    <BzsDataGridColumn TItem="ReviewRow"
                                       Key="owner"
                                       Title="@DemoText.Productivity.CompactGridOwnerColumn"
                                       ValueSelector="row => row.Owner" />
                </BzsDataGrid>
            </DemoShowcaseSection>
        </div>
    </DemoShowcaseSection>
</section>

@code {
    [SupplyParameterFromQuery(Name = "rejectGridSelection")]
    public bool RejectGridSelection { get; set; }

    private IReadOnlyList<BzsBreadcrumbItem> BreadcrumbItems =>
    [
        new("Home", Links.To(DemoCatalogDestinations.Overview)),
        new("Productivity", current: true),
    ];
    private readonly OwnerProvider _ownerProvider = new();
    private readonly DemoGridProvider _gridProvider = new();
    private static readonly IReadOnlyList<int> PageSizeOnlyGridOptions = [1, 2];
    private static readonly IReadOnlyList<int> WorkbenchPageSizeOptions = [4, 8];
    private static readonly IReadOnlyList<string> WorkbenchOwners =
        ["Alicia Santos", "Ben Carter", "Mei Lin"];
    private IReadOnlyList<WorkbenchRow> WorkbenchRows =>
    [
        new(1, DemoText.Productivity.HarborLighting, "Alicia Santos", DemoText.Productivity.StatusOpen, 12.5m, new DateOnly(2026, 9, 4), DemoText.Productivity.HarborLightingNotes),
        new(2, DemoText.Productivity.WarehouseAccessibility, "Ben Carter", DemoText.Productivity.StatusBlocked, 8m, new DateOnly(2026, 9, 11), DemoText.Productivity.WarehouseAccessibilityNotes),
        new(3, DemoText.Productivity.ReleaseNotesReview, "Mei Lin", DemoText.Productivity.StatusDone, 3.5m, new DateOnly(2026, 8, 28), DemoText.Productivity.ReleaseNotesReviewNotes),
        new(4, DemoText.Productivity.TabletNavigation, "Alicia Santos", DemoText.Productivity.StatusOpen, 16m, new DateOnly(2026, 9, 18), DemoText.Productivity.TabletNavigationNotes),
        new(5, DemoText.Productivity.ContrastAudit, "Ben Carter", DemoText.Productivity.StatusOpen, 6m, new DateOnly(2026, 9, 2), DemoText.Productivity.ContrastAuditNotes),
        new(6, DemoText.Productivity.LocalizationPass, "Mei Lin", DemoText.Productivity.StatusDone, 9m, new DateOnly(2026, 8, 25), DemoText.Productivity.LocalizationPassNotes),
    ];
    private IReadOnlyList<ReviewRow> CompactGridRows =>
    [
        new(
            901,
            DemoText.Productivity.CompactGridReleaseNotes,
            "Mei",
            DemoText.Productivity.CompactGridNormalPriority),
        new(
            902,
            DemoText.Productivity.CompactGridKeyboardAudit,
            "Alicia",
            DemoText.Productivity.CompactGridHighPriority),
    ];
    private readonly WorkbenchForm _form = new();
    private bool _chipSelected = true;
    private bool _chipVisible = true;
    private bool _reviewQueueOpen = true;
    private bool _popoverOpen;
    private bool _menuOpen;
    private bool _contextMenuOpen;
    private int _page = 1;
    private string _commandStatus = "Ready for a review command.";
    private int _gridPage = 1;
    private int _gridPageSize = 5;
    private static readonly IReadOnlyList<int> _gridPageSizeOptions = [5, 10, 25];
    private BzsDataGridSort? _gridSort;
    private IReadOnlyList<BzsDataGridFilter> _gridFilters = Array.Empty<BzsDataGridFilter>();
    private IReadOnlyList<ReviewRow> _selectedRows = Array.Empty<ReviewRow>();
    private BzsDataGrid<ReviewRow>? _grid;
    private bool _gridRefreshed;
    private int _pageSizeOnlyGridPageSize = 1;
    private int _workbenchPage = 1;
    private int _workbenchPageSize = 4;
    private IReadOnlyList<BzsDataGridSort> _workbenchSorts = Array.Empty<BzsDataGridSort>();
    private IReadOnlyList<BzsDataGridFilter> _workbenchFilters = Array.Empty<BzsDataGridFilter>();
    private IReadOnlyList<string> _workbenchHiddenColumns = Array.Empty<string>();
    private IReadOnlyList<object?> _workbenchExpandedRows = Array.Empty<object?>();
    private string? _workbenchSearch;

    private string GridRefreshStatus => _gridRefreshed
        ? DemoText.Productivity.GridRefreshed
        : DemoText.Productivity.GridRefreshReady;

    private Task RemoveChip(MouseEventArgs _)
    {
        _chipVisible = false;
        return Task.CompletedTask;
    }

    private Task MarkReady() { _commandStatus = "Review marked ready."; return Task.CompletedTask; }
    private Task AssignReviewer() { _commandStatus = "Reviewer assignment opened."; return Task.CompletedTask; }
    private Task OpenReview() { _commandStatus = "Review opened."; return Task.CompletedTask; }
    private Task CopyReviewLink() { _commandStatus = "Review link copied."; return Task.CompletedTask; }

    private async Task RefreshGridAsync()
    {
        if (_grid is null)
        {
            return;
        }

        await _grid.RefreshAsync();
        _gridRefreshed = true;
    }

    private void HandleGridSelectionChanged(IReadOnlyList<ReviewRow> value)
    {
        if (!RejectGridSelection)
        {
            _selectedRows = value;
        }
    }

    private sealed class OwnerProvider : IBzsAutocompleteProvider<string>
    {
        private static readonly IReadOnlyList<BzsAutocompleteOption<string>> Options =
        [
            new("alicia", "Alicia Santos") { Description = "Workspace administrator", Icon = BzsIcons.Info },
            new("ben", "Ben Carter") { Description = "Accessibility reviewer", Icon = BzsIcons.Info },
            new("mei", "Mei Lin") { Description = "Release manager", Icon = BzsIcons.Info },
        ];

        public ValueTask<IReadOnlyList<BzsAutocompleteOption<string>>> GetSuggestionsAsync(
            string query,
            CancellationToken cancellationToken)
        {
            var matches = Options
                .Where(option => option.Label.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToArray();
            return ValueTask.FromResult<IReadOnlyList<BzsAutocompleteOption<string>>>(matches);
        }
    }

    private sealed class DemoGridProvider : IBzsDataGridProvider<ReviewRow>
    {
        private static readonly IReadOnlyList<ReviewRow> Rows =
        [
            new(1, "North Harbor lighting", "Alicia Santos", "High"),
            new(2, "Warehouse accessibility", "Ben Carter", "Medium"),
            new(3, "Release notes review", "Mei Lin", "Low"),
            new(4, "Tablet navigation", "Alicia Santos", "High"),
            new(5, "Color contrast audit", "Ben Carter", "Medium"),
            new(6, "Localization pass", "Mei Lin", "Low"),
            new(7, "Keyboard regression", "Alicia Santos", "High"),
            new(8, "Upload policy", "Ben Carter", "Medium"),
        ];

        public async ValueTask<BzsDataGridResult<ReviewRow>> GetItemsAsync(
            BzsDataGridRequest request,
            CancellationToken cancellationToken)
        {
            await Task.Delay(TimeSpan.FromMilliseconds(75), cancellationToken);
            IEnumerable<ReviewRow> query = Rows;
            foreach (var filter in request.Filters.OfType<BzsDataGridTextFilter>())
            {
                query = filter.ColumnKey switch
                {
                    "title" => query.Where(row => Matches(row.Title, filter)),
                    "owner" => query.Where(row => Matches(row.Owner, filter)),
                    "priority" => query.Where(row => Matches(row.Priority, filter)),
                    _ => query,
                };
            }

            if (request.Sort is { } sort)
            {
                query = sort.Direction == BzsDataGridSortDirection.Ascending
                    ? query.OrderBy(row => sort.ColumnKey == "owner" ? row.Owner : sort.ColumnKey == "priority" ? row.Priority : row.Title, StringComparer.Ordinal)
                    : query.OrderByDescending(row => sort.ColumnKey == "owner" ? row.Owner : sort.ColumnKey == "priority" ? row.Priority : row.Title, StringComparer.Ordinal);
            }

            var total = query.Count();
            var page = query.Skip((request.Page - 1) * request.PageSize).Take(request.PageSize).ToArray();
            return new BzsDataGridResult<ReviewRow>(page, total);
        }

        private static bool Matches(string value, BzsDataGridTextFilter filter)
        {
            var comparison = filter.CaseSensitive
                ? StringComparison.CurrentCulture
                : StringComparison.CurrentCultureIgnoreCase;
            return filter.Operator switch
            {
                BzsDataGridTextOperator.Contains => value.Contains(filter.Value, comparison),
                BzsDataGridTextOperator.StartsWith => value.StartsWith(filter.Value, comparison),
                BzsDataGridTextOperator.EndsWith => value.EndsWith(filter.Value, comparison),
                BzsDataGridTextOperator.Equals => value.Equals(filter.Value, comparison),
                _ => false,
            };
        }
    }

    private sealed class WorkbenchForm
    {
        public string Owner { get; set; } = string.Empty;
        public IReadOnlyList<IBrowserFile> Files { get; set; } = Array.Empty<IBrowserFile>();
    }

    private sealed record ReviewRow(int Id, string Title, string Owner, string Priority);

    private sealed record WorkbenchRow(
        int Id,
        string Title,
        string Owner,
        string Status,
        decimal Hours,
        DateOnly Due,
        string Notes);
}
