@page "/"

<PageTitle>Bzs.Blazor catalog</PageTitle>

<section class="demo-page" aria-labelledby="catalog-title">
    <header class="demo-page-header">
        <p class="demo-eyebrow">.NET 10 component catalog</p>
        <h1 id="catalog-title">Bzs.Blazor</h1>
        <p class="demo-page-summary">
            Foundation, forms, feedback, navigation, and overlays in one focused workbench.
        </p>
    </header>

    <section class="demo-overview-section" aria-labelledby="component-catalog-title">
        <div class="demo-section-heading">
            <h2 id="component-catalog-title">Component groups</h2>
        </div>
        <div class="demo-overview-grid">
            <a class="demo-overview-card" href="theme-foundation"><span class="demo-overview-card-index">01</span><strong>Theme foundation</strong></a>
            <a class="demo-overview-card" href="foundation"><span class="demo-overview-card-index">02</span><strong>Foundation</strong></a>
            <a class="demo-overview-card" href="forms"><span class="demo-overview-card-index">03</span><strong>Forms</strong></a>
            <a class="demo-overview-card" href="feedback"><span class="demo-overview-card-index">04</span><strong>Feedback</strong></a>
            <a class="demo-overview-card" href="tabs"><span class="demo-overview-card-index">05</span><strong>Tabs</strong></a>
            <a class="demo-overview-card" href="overlays"><span class="demo-overview-card-index">06</span><strong>Overlays</strong></a>
        </div>
    </section>

    <section class="demo-overview-section" aria-labelledby="route-catalog-title">
        <h2 id="route-catalog-title">Render-mode routes</h2>
        <ul class="demo-route-list">
            <li><a href="render-modes/static">Static SSR</a><span>Meaningful passive markup.</span></li>
            <li><a href="render-modes/server">Interactive Server</a><span>Server circuit interaction.</span></li>
            <li><a href="render-modes/webassembly">Interactive WebAssembly</a><span>Browser-hosted interaction.</span></li>
            <li><a href="render-modes/auto">Interactive Auto</a><span>Automatic server-to-browser selection.</span></li>
        </ul>
    </section>
</section>
